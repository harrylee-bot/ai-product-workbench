{
  "name": "ai-product-workbench",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm --workspace @ai-product-workbench/api run dev",
    "dev:web": "npm --workspace @ai-product-workbench/web run dev",
    "build": "npm --workspace @ai-product-workbench/api run build && npm --workspace @ai-product-workbench/web run build",
    "typecheck": "npm --workspace @ai-product-workbench/api run typecheck && npm --workspace @ai-product-workbench/web run typecheck",
    "test": "npm --workspace @ai-product-workbench/api run test",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:seed": "npm --workspace @ai-product-workbench/db run seed",
    "axure:export": "node scripts/axure-rp-export-html.mjs",
    "deerflow:bootstrap": "node scripts/deerflow-bootstrap.mjs"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "multer": "2.2.0",
    "postcss": "8.5.16",
    "vite": "8.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
