{
  "name": "ai-product-workbench",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm --workspace @ai-product-workbench/api run dev",
    "dev:web": "npm --workspace @ai-product-workbench/web run dev",
    "build": "npm --workspace @ai-product-workbench/api run build && npm --workspace @ai-product-workbench/web run build",
    "typecheck": "npm --workspace @ai-product-workbench/api run typecheck && npm --workspace @ai-product-workbench/web run typecheck",
    "test": "npm --workspace @ai-product-workbench/api run test",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:assert-no-legacy": "node scripts/assert-no-legacy-schema.mjs",
    "web:assert-security-headers": "tsx scripts/assert-web-security-headers.ts",
    "knowledge:assert-pinned": "node scripts/assert-knowledge-build-pins.mjs",
    "audit:knowledge-vault": "node scripts/knowledge-vault-audit.mjs",
    "eval:agent-workflow": "node scripts/agent-workflow-eval.mjs",
    "eval:agent-workflow:generalization": "npm --workspace @ai-product-workbench/api exec vitest run test/agent-workflow-generalization.spec.ts",
    "smoke:agent-workflow:online": "node scripts/agent-workflow-online-smoke.mjs",
    "smoke:admin-write": "node scripts/admin-write-smoke.mjs",
    "db:seed": "npm --workspace @ai-product-workbench/db run seed",
    "cleanup:smoke": "node scripts/cleanup-smoke-data.mjs",
    "axure:export": "node scripts/axure-rp-export-html.mjs",
    "deerflow:bootstrap": "node scripts/deerflow-bootstrap.mjs",
    "deerflow:patch": "bash scripts/deerflow-apply-patches.sh"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "multer": "2.2.0",
    "postcss": "8.5.16",
    "vite": "8.1.3"
  },
  "devDependencies": {
    "@prisma/client": "^6.16.0",
    "@types/node": "^22.10.0",
    "bcryptjs": "^2.4.3",
    "prisma": "^6.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.1",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
