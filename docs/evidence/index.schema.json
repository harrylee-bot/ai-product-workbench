{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/evidence/index.schema.json",
  "title": "Product Workbench evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "payload",
    "payloadSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "workbench.evidence-index.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indexId",
        "createdAtUtc",
        "ledgerReferences"
      ],
      "properties": {
        "indexId": {
          "$ref": "#/$defs/identifier"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/utc"
        },
        "ledgerReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ledgerReference"
          }
        }
      }
    },
    "payloadSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "ledgerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerId",
        "uri",
        "sha256"
      ],
      "properties": {
        "ledgerId": {
          "$ref": "#/$defs/identifier"
        },
        "uri": {
          "type": "string",
          "pattern": "^file:\\.\\/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
