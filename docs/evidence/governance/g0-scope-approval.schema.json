{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/evidence/governance/g0-scope-approval.schema.json",
  "title": "Product Workbench G0 scope and ownership approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "product",
    "gateId",
    "executionStatus",
    "recordedAtUtc",
    "candidate",
    "environment",
    "scope",
    "capabilities",
    "responsibilityMatrix",
    "waivers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "workbench.g0-scope-approval.v1"
    },
    "recordId": {
      "$ref": "#/$defs/identifier"
    },
    "product": {
      "const": "产品工作台"
    },
    "gateId": {
      "const": "G0"
    },
    "executionStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT RUN",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "recordedAtUtc": {
      "$ref": "#/$defs/utc"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "responsibilityMatrix": {
      "$ref": "#/$defs/responsibilityMatrix"
    },
    "waivers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/waiver"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "identifier": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "role": {
      "enum": [
        "Implementer",
        "Security",
        "Data",
        "Operations",
        "Evidence",
        "Release"
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "signedTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tagObject",
        "payloadSha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "tagObject": {
          "$ref": "#/$defs/gitObject"
        },
        "payloadSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "sourceCommit",
        "signedTag",
        "manifest"
      ],
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/candidateId"
        },
        "sourceCommit": {
          "$ref": "#/$defs/gitObject"
        },
        "signedTag": {
          "$ref": "#/$defs/signedTag"
        },
        "manifest": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId",
        "kind",
        "target",
        "region"
      ],
      "properties": {
        "environmentId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "local",
            "ci",
            "server",
            "staging",
            "production"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateIds",
        "findingIds"
      ],
      "properties": {
        "gateIds": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^G(?:[0-9]|1[0-2])$"
          }
        },
        "findingIds": {
          "type": "array",
          "minItems": 67,
          "maxItems": 67,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:D|P)-[0-9]{3}$"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "approverRole",
        "approverId",
        "decision",
        "signedAtUtc",
        "reference"
      ],
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/identifier"
        },
        "approverRole": {
          "$ref": "#/$defs/role"
        },
        "approverId": {
          "$ref": "#/$defs/identifier"
        },
        "decision": {
          "const": "APPROVE"
        },
        "signedAtUtc": {
          "$ref": "#/$defs/utc"
        },
        "reference": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "name",
        "classification",
        "reason",
        "classificationExpiresAtUtc",
        "accountableRole",
        "targetDateUtc",
        "escalationPath",
        "overdueAction",
        "approvals"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "classification": {
          "enum": [
            "advertised",
            "deferred",
            "N/A"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "classificationExpiresAtUtc": {
          "$ref": "#/$defs/utc"
        },
        "accountableRole": {
          "$ref": "#/$defs/role"
        },
        "targetDateUtc": {
          "$ref": "#/$defs/utc"
        },
        "escalationPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "overdueAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "approvals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "team"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "roleOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "owner",
        "responsibilities",
        "approval"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "approval": {
          "oneOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeItemIds",
        "targetDateUtc",
        "escalationPath",
        "overdueAction"
      ],
      "properties": {
        "scopeItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:G(?:[0-9]|1[0-2])|(?:D|P)-[0-9]{3})$"
          }
        },
        "targetDateUtc": {
          "$ref": "#/$defs/utc"
        },
        "escalationPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "overdueAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "responsibilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owners",
        "schedule"
      ],
      "properties": {
        "owners": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/roleOwner"
          }
        },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/schedule"
          }
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "controlCategory",
        "relatedGateIds",
        "relatedFindingIds",
        "businessReason",
        "verifiedFacts",
        "compensatingControls",
        "ownerRole",
        "approvals",
        "expiresAtUtc",
        "reviewTriggers",
        "rollbackOrForwardRepair"
      ],
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/identifier"
        },
        "controlCategory": {
          "enum": [
            "schedule",
            "non-production-feature-scope",
            "performance-advisory",
            "usability-advisory",
            "documentation",
            "source-provenance",
            "tenant-isolation",
            "secret-exposure",
            "object-checksum-integrity",
            "irreversible-data-recovery",
            "independent-production-approval"
          ]
        },
        "relatedGateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^G(?:[0-9]|1[0-2])$"
          }
        },
        "relatedFindingIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:D|P)-[0-9]{3}$"
          }
        },
        "businessReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "verifiedFacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "compensatingControls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "ownerRole": {
          "$ref": "#/$defs/role"
        },
        "approvals": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/approval"
          }
        },
        "expiresAtUtc": {
          "$ref": "#/$defs/utc"
        },
        "reviewTriggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "rollbackOrForwardRepair": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
