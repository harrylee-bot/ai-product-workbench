{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionbench.com/schemas/workbench.production-acceptance-control-catalog.v1.json",
  "title": "Product Workbench production acceptance control catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "technicalIdentifier", "catalogId", "capacityProfile", "gates"],
  "properties": {
    "schemaVersion": { "const": "workbench.production-acceptance-control-catalog.v1" },
    "product": { "const": "产品工作台" },
    "technicalIdentifier": { "const": "workbench" },
    "catalogId": { "$ref": "#/$defs/identifier" },
    "capacityProfile": { "$ref": "#/$defs/capacityProfile" },
    "gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "controls"],
        "properties": {
          "gateId": { "enum": ["G5", "G6", "G7", "G8", "G9", "G10", "G11"] },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/control" }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$"
    },
    "capacityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "status",
        "activeRuns",
        "workerReplicas",
        "runtimeConcurrencyPerReplica",
        "cancellationQueryBatchSize",
        "pollIntervalMs",
        "maxPollerQpsPerReplica",
        "cancelP95Ms",
        "recoveryMs"
      ],
      "properties": {
        "profileId": { "$ref": "#/$defs/identifier" },
        "status": { "const": "proposed-baseline" },
        "activeRuns": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "workerReplicas": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "runtimeConcurrencyPerReplica": { "type": "integer", "minimum": 1, "maximum": 64 },
        "cancellationQueryBatchSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "pollIntervalMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "maxPollerQpsPerReplica": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "cancelP95Ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "recoveryMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlId",
        "controlObjective",
        "prerequisites",
        "procedure",
        "expectedObservation",
        "threshold",
        "evidenceLevel",
        "tool",
        "relatedFindingsOrDecisions"
      ],
      "properties": {
        "controlId": { "$ref": "#/$defs/identifier" },
        "controlObjective": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "procedure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "command"],
              "properties": {
                "kind": { "const": "command" },
                "command": { "type": "string", "minLength": 1, "maxLength": 16384 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "predicateType", "subject"],
              "properties": {
                "kind": { "const": "attestation" },
                "predicateType": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048 },
                "subject": { "$ref": "#/$defs/identifier" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "section"],
              "properties": {
                "kind": { "const": "runbook" },
                "path": { "type": "string", "pattern": "^docs/runbooks/[A-Za-z0-9][A-Za-z0-9._/-]*\\.md$" },
                "section": { "type": "string", "minLength": 1, "maxLength": 256 }
              }
            }
          ]
        },
        "expectedObservation": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "threshold": { "$ref": "#/$defs/threshold" },
        "evidenceLevel": { "enum": ["E1", "E2"] },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "relatedFindingsOrDecisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["finding", "decision"] },
              "id": { "$ref": "#/$defs/identifier" }
            }
          }
        }
      }
    },
    "threshold": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operator", "expected"],
          "properties": {
            "kind": { "const": "boolean" },
            "operator": { "const": "eq" },
            "expected": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operator", "expected", "unit"],
          "properties": {
            "kind": { "const": "number" },
            "operator": { "enum": ["eq", "lt", "lte", "gt", "gte"] },
            "expected": { "type": "number" },
            "unit": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      ]
    }
  }
}
