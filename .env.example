# ===== 数据库 =====
# 本地开发用占位口令；生产必须改为强随机口令，不得使用此默认值。
DATABASE_URL="postgresql://ai_workbench:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/ai_product_workbench?schema=public"

# ===== 鉴权（必填，缺失即启动失败）=====
# 必须为长随机串。生产部署脚本对默认/空值会 fail-fast 拒绝启动。
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# ===== 模型网关加密密钥（配置 provider API key 时必填）=====
# 必须为 32 字节 base64 或 64 位 hex。不再回退到 JWT_SECRET 或硬编码 dev secret。
# 生成示例：openssl rand -base64 32
MODEL_GATEWAY_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_OR_64_HEX"
MODEL_GATEWAY_KEEP_ONLY_DEFAULT_PROVIDER="true"
MODEL_GATEWAY_HIDE_DISABLED_PROVIDERS="true"
DEFAULT_MODEL_PROVIDER_NAME="datatoken"
DEFAULT_MODEL_BASE_URL="https://datatoken.shop"
DEFAULT_MODEL_API_KEY="REPLACE_WITH_PROVIDER_API_KEY"
DEFAULT_MODEL_NAME="gpt-5.5"
OPENAI_BASE_URL="https://datatoken.shop"
OPENAI_MODEL="gpt-5.5"
OPENAI_API_KEY="REPLACE_WITH_PROVIDER_API_KEY"

# ===== Web / API / 知识库 =====
API_PORT="4000"
# 必填：CORS 允许的来源（逗号分隔）。缺失即启动失败，不再回退允许任意来源。
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
NEXT_PUBLIC_KNOWLEDGE_APP_URL="http://localhost:3001"
KNOWLEDGE_APP_PORT="3001"
QUARTZ_REF="v5"
QUARTZ_BASE_URL="localhost:3001"

# ===== DeerFlow（使命关键开关）=====
# 生产必须为 true：false 时自然语言→PRD→原型链路断开（handleMessage 返回停用文案）。
DEERFLOW_ENABLED="true"
DEERFLOW_LANGGRAPH_URL="http://localhost:2024"
DEERFLOW_GATEWAY_URL="http://localhost:8001"
DEERFLOW_ASSISTANT_ID="lead_agent"
# bootstrap 后填入 agent 名（如 ai-product-workbench-lead）。
DEERFLOW_AGENT_NAME=""
# 流模式必须与 DeerFlow 实例输出一致；默认 messages,values（含 updates/custom 以支持节点级步骤事件）。
DEERFLOW_STREAM_MODE="messages,values"
# 若 DeerFlow Gateway 开启内部认证，需与 DeerFlow 的 DEER_FLOW_INTERNAL_AUTH_TOKEN 一致；
# Workbench 会同时发送 X-DeerFlow-Owner-User-Id，确保 DeerFlow 记忆/线程按当前用户隔离。
DEERFLOW_INTERNAL_AUTH_TOKEN=""
DEERFLOW_PLAN_MODE="true"
DEERFLOW_THINKING_ENABLED="true"
DEERFLOW_SUBAGENT_ENABLED="true"
DEERFLOW_MAX_CONCURRENT_SUBAGENTS="3"
DEERFLOW_TIMEOUT_MS="600000"
DEERFLOW_UPLOADS_ENABLED="true"
DEERFLOW_ARTIFACT_MAX_INLINE_BYTES="2000000"
