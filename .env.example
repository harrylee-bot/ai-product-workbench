# ===== 数据库 =====
# 本地开发用占位口令；生产必须改为强随机口令，不得使用此默认值。
DATABASE_URL="postgresql://ai_workbench:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/ai_product_workbench?schema=public"
WORKBENCH_DATABASE_URL="postgresql://ai_workbench:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/ai_product_workbench?schema=workbench"

# ===== 鉴权（必填，缺失即启动失败）=====
# 必须为长随机串。生产部署脚本对默认/空值会 fail-fast 拒绝启动。
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
# 留空时开发环境开启、生产环境关闭；生产确需公开注册时必须显式设为 true。
PUBLIC_REGISTRATION_ENABLED=""

# ===== 模型网关加密密钥（配置 provider API key 时必填）=====
# 必须为 32 字节 base64 或 64 位 hex。不再回退到 JWT_SECRET 或硬编码 dev secret。
# 生成示例：openssl rand -base64 32
MODEL_GATEWAY_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_OR_64_HEX"
MODEL_GATEWAY_KEEP_ONLY_DEFAULT_PROVIDER="true"
MODEL_GATEWAY_HIDE_DISABLED_PROVIDERS="true"
DEFAULT_MODEL_PROVIDER_NAME="datatoken"
# OpenAI-compatible API root; keep the provider's /v1 path in the base URL.
DEFAULT_MODEL_BASE_URL="https://datatoken.shop/v1"
DEFAULT_MODEL_API_KEY="REPLACE_WITH_PROVIDER_API_KEY"
# 兜底模型；未单独指定阶段模型时，所有任务都会路由到这里。
DEFAULT_MODEL_NAME="gpt-5.5"
# 可选：按能力阶段配置模型。留空时回退到 DEFAULT_MODEL_NAME。
DEFAULT_MODEL_FAST_NAME=""
DEFAULT_MODEL_REASONING_NAME=""
DEFAULT_MODEL_LONG_CONTEXT_NAME=""
DEFAULT_MODEL_CODE_NAME=""
# 可选：按具体任务覆盖阶段模型。变量名格式：
# DEFAULT_MODEL_TASK_<ModelTaskType 大写>_NAME，例如：
DEFAULT_MODEL_TASK_INTENT_DETECTION_NAME=""
DEFAULT_MODEL_TASK_PRD_GENERATION_NAME=""
DEFAULT_MODEL_TASK_PROTOTYPE_CODE_GENERATION_NAME=""
DEFAULT_MODEL_TASK_QA_CHECK_NAME=""
# OpenAI-compatible API root used by legacy/local adapters.
OPENAI_BASE_URL="https://datatoken.shop/v1"
OPENAI_MODEL="gpt-5.5"
OPENAI_API_KEY="REPLACE_WITH_PROVIDER_API_KEY"

# ===== Web / API / 知识库 =====
API_PORT="4000"
WORKBENCH_API_PORT="4100"
WORKBENCH_API_HOST="127.0.0.1"
WORKBENCH_WEB_ORIGIN="http://localhost:3000"
# 仅供 Next 服务端 BFF 使用；浏览器固定请求同源 /api/v1，不配置公开 API 基址。
WORKBENCH_API_INTERNAL_URL="http://127.0.0.1:4100/api/v1"
WORKBENCH_BFF_MAX_REQUEST_BYTES="2097152"
# Dedicated invitation signing key. Do not reuse the Preview, auth, or Knowledge keys.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WORKBENCH_INVITATION_TOKEN_SECRET="REPLACE_WITH_BASE64URL_32_BYTE_SECRET"
WORKBENCH_INVITATION_TOKEN_PREVIOUS_SECRETS=""
WORKBENCH_INVITATION_TTL_HOURS="168"
WORKBENCH_PREVIEW_ORIGIN="http://localhost:4300"
# Base64url-encoded random secret of at least 32 bytes; API and Preview must share it.
WORKBENCH_PREVIEW_TOKEN_SECRET="REPLACE_WITH_BASE64URL_32_BYTE_SECRET"
WORKBENCH_PREVIEW_TOKEN_MAX_TTL_SECONDS="3600"
WORKBENCH_PREVIEW_MAX_HTML_BYTES="52428800"
WORKBENCH_PREVIEW_MAX_CONCURRENCY="4"
WORKBENCH_PREVIEW_SPOOL_DIR="/tmp/workbench-preview"
# Use oidc outside local development. Development mode is rejected when NODE_ENV=production.
WORKBENCH_AUTH_MODE="development"
OIDC_ISSUER="https://identity.example.com/realms/workbench"
OIDC_AUDIENCE="workbench"
OIDC_JWKS_URL="https://identity.example.com/realms/workbench/protocol/openid-connect/certs"
# 本地开发默认只监听回环地址；Docker 内由 Compose 覆盖为 0.0.0.0，并仅发布到宿主机回环地址。
API_HOST="127.0.0.1"
# 仅填写实际反向代理来源。禁止 true/*；本地直连保持 false。
TRUST_PROXY="false"
# Docker 反代来源；留空使用 Compose 的 loopback/linklocal/uniquelocal 安全默认值。
DOCKER_TRUST_PROXY=""
# 必填：CORS 允许的来源（逗号分隔）。缺失即启动失败，不再回退允许任意来源。
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_KNOWLEDGE_APP_URL="http://localhost:3001"
# 本地默认使用仓库根目录的知识库；生产可覆盖到共享 volume 中的 knowledge-vault。
KNOWLEDGE_VAULT_ROOT="./knowledge-vault"
# Docker 部署需要覆盖容器内路径时使用；未配置时使用 /app/apps/api/storage/knowledge-vault。
DOCKER_KNOWLEDGE_VAULT_ROOT=""
# Docker 默认在 API 启动后同步 Markdown 到项目数据库，并每 24 小时复核一次。
KNOWLEDGE_DAILY_SYNC_ENABLED="true"
KNOWLEDGE_DAILY_SYNC_ON_STARTUP="true"
KNOWLEDGE_DAILY_SYNC_INTERVAL_MS="86400000"
# 单轮聊天送入 Agent 的附件预算，限制 DeerFlow multipart 聚合的内存上界。
CHAT_ATTACHMENT_MAX_FILES="8"
CHAT_ATTACHMENT_MAX_TOTAL_BYTES="67108864"
# 启动时把中断的解析/转换任务收敛到可重试状态，并恢复有限数量的排队转换。
FILE_RECOVERY_ENABLED="true"
FILE_RECOVERY_MAX_QUEUED_CONVERSIONS="20"
KNOWLEDGE_APP_PORT="3001"
QUARTZ_REF="v5"
QUARTZ_BASE_URL="localhost:3001"
# 生产环境首次初始化管理员必须显式配置；开发环境未配置时使用 README 中的默认账号。
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.local"

# Optional public product destinations. Invalid or absent URLs keep the related
# product menu item explicitly disabled. Feedback accepts HTTPS or mailto;
# forum and privacy accept HTTPS only.
NEXT_PUBLIC_WORKBENCH_FEEDBACK_URL=""
NEXT_PUBLIC_WORKBENCH_FORUM_URL=""
NEXT_PUBLIC_WORKBENCH_PRIVACY_URL=""

# ===== DeerFlow（使命关键开关）=====
# 生产必须为 true：false 时自然语言→PRD→原型链路断开（handleMessage 返回停用文案）。
DEERFLOW_ENABLED="true"
DEERFLOW_LANGGRAPH_URL="http://localhost:2024"
DEERFLOW_GATEWAY_URL="http://localhost:8001"
DEERFLOW_READINESS_TIMEOUT_MS="5000"
# 开启后 /api/ready 会把 DeerFlow 纳入就绪条件；健康地址可按实际网关覆盖。
DEERFLOW_READINESS_REQUIRED="false"
DEERFLOW_HEALTH_URL=""
DEERFLOW_HEALTH_TIMEOUT_MS="2000"
DEERFLOW_ASSISTANT_ID="lead_agent"
# bootstrap 后填入 agent 名（如 workbench-lead）。
DEERFLOW_AGENT_NAME=""
DEERFLOW_MODEL_NAME=""
DEERFLOW_MODEL_DISPLAY_NAME=""
DEERFLOW_MODEL_PROVIDER=""
# DeerFlow 2.1 请求模式默认为 messages-tuple,values；服务端 token 事件名仍为 messages。
DEERFLOW_STREAM_MODE="messages-tuple,values"
# 生产启用 DeerFlow 时必填（至少 32 字符），并与 DeerFlow 的 DEER_FLOW_INTERNAL_AUTH_TOKEN 一致。
# 这是 Runtime 服务身份：Workbench 会同时发送 X-DeerFlow-Owner-User-Id 做用户隔离；它不具备管理员权限。
DEERFLOW_INTERNAL_AUTH_TOKEN=""
# 仅供 `npm run deerflow:bootstrap` 做管理员作用域验证安装。填写真实 DeerFlow admin 用户签发的原始会话 access token；
# 脚本按当前 Gateway 合同使用 access_token Cookie + CSRF，且绝不回退或复用上面的内部服务 token。
# custom skill 是 per-user；生产必须把 workbench 作为只读 PUBLIC skill 随 DeerFlow 部署交付。
DEERFLOW_ADMIN_ACCESS_TOKEN=""
AGENT_RUN_LEASE_MS="45000"
AGENT_RUN_HEARTBEAT_MS="15000"
DEERFLOW_REPLACE_THREAD_ON_ACTIVE_RUN="false"
DEERFLOW_PLAN_MODE="true"
DEERFLOW_THINKING_ENABLED="true"
DEERFLOW_SUBAGENT_ENABLED="true"
DEERFLOW_MAX_CONCURRENT_SUBAGENTS="3"
DEERFLOW_TIMEOUT_MS="600000"
DEERFLOW_IDLE_TIMEOUT_MS="120000"
WORKBENCH_RUNTIME_CONCURRENCY="2"
# Runtime Run/Attempt fencing. Heartbeats must remain below half the lease.
WORKBENCH_RUNTIME_EXECUTION_LEASE_MS="45000"
WORKBENCH_RUNTIME_EXECUTION_HEARTBEAT_MS="15000"
WORKBENCH_RUNTIME_EXECUTION_RECONCILE_INTERVAL_MS="5000"
WORKBENCH_RUNTIME_EXECUTION_RECONCILE_BATCH_SIZE="100"
# File Worker Blob GC. One week is the production-safe default grace; values
# below one hour are rejected. BlobScan rows remain as non-owning audit evidence.
WORKBENCH_BLOB_GC_CONCURRENCY="1"
WORKBENCH_BLOB_GC_GRACE_MS="604800000"
WORKBENCH_BLOB_GC_RECONCILIATION_INTERVAL_MS="300000"
WORKBENCH_BLOB_GC_BATCH_SIZE="100"
# ===== Greenfield Knowledge capability / retrieval =====
# No ready Knowledge release: keep the URL, secret, and every provider pin empty.
# Once a ready release exists, API readiness requires this complete configuration.
# API and Runtime Worker must share the same base64url secret (at least 32 random bytes).
# Generate locally with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WORKBENCH_KNOWLEDGE_TOOL_URL=""
WORKBENCH_KNOWLEDGE_TOOL_SECRET=""
WORKBENCH_KNOWLEDGE_TOOL_MAX_TTL_SECONDS="3600"
WORKBENCH_KNOWLEDGE_READINESS_TIMEOUT_MS="4000"
# ===== Live Canvas Agent capability =====
# API and Runtime Worker share this independent base64url secret. The browser
# never receives it; DeerFlow receives only a request-scoped short-lived grant.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WORKBENCH_CANVAS_TOOL_URL=""
WORKBENCH_CANVAS_VISUAL_URL=""
WORKBENCH_CANVAS_TOOL_SECRET=""
WORKBENCH_CANVAS_TOOL_MAX_TTL_SECONDS="300"
WORKBENCH_CANVAS_COMMAND_TTL_SECONDS="60"
WORKBENCH_CANVAS_INVOCATION_LEASE_SECONDS="30"
WORKBENCH_CANVAS_EXPIRY_RECONCILIATION_BATCH_SIZE="100"
WORKBENCH_CANVAS_EXPIRY_RECONCILIATION_INTERVAL_MS="5000"
# Trusted operator-only KnowledgeRelease producer. Prefer explicit CLI flags;
# these values are read by `npm run knowledge:release`, not by the browser.
WORKBENCH_KNOWLEDGE_PROFILE_OPERATOR_ACTION=""
WORKBENCH_KNOWLEDGE_PROFILE_OPERATOR_ISSUER=""
WORKBENCH_KNOWLEDGE_PROFILE_OPERATOR_SUBJECT=""
WORKBENCH_KNOWLEDGE_PROFILE_OPERATOR_AUTHORIZED_BY=""
WORKBENCH_KNOWLEDGE_PROFILE_OPERATOR_CHANGE_REFERENCE=""
WORKBENCH_KNOWLEDGE_RELEASE_KEY=""
WORKBENCH_KNOWLEDGE_RELEASE_VERSION=""
WORKBENCH_KNOWLEDGE_WORKSPACE_ID=""
WORKBENCH_KNOWLEDGE_EMBEDDING_PROFILE_ID=""
WORKBENCH_KNOWLEDGE_EMBEDDING_PROFILE_SPEC_SHA256=""
WORKBENCH_KNOWLEDGE_RETRIEVAL_PROFILE_ID=""
# File Worker only: local files from the exact tokenizer revision pinned by the
# adopted EmbeddingProfile. They are read locally and never downloaded at runtime.
WORKBENCH_KNOWLEDGE_TOKENIZER_JSON_PATH=""
WORKBENCH_KNOWLEDGE_TOKENIZER_CONFIG_JSON_PATH=""
WORKBENCH_KNOWLEDGE_TOKENIZER_MAX_FILE_BYTES="134217728"
WORKBENCH_TEI_URL=""
WORKBENCH_TEI_API_KEY=""
WORKBENCH_TEI_IMAGE_DIGEST=""
WORKBENCH_TEI_REQUEST_TIMEOUT_MS="30000"
WORKBENCH_TEI_MAX_REQUEST_BYTES="8388608"
WORKBENCH_TEI_MAX_RESPONSE_BYTES="33554432"
WORKBENCH_KNOWLEDGE_RERANKER_URL=""
WORKBENCH_KNOWLEDGE_RERANKER_API_KEY=""
WORKBENCH_KNOWLEDGE_RERANKER_IMAGE_DIGEST=""
WORKBENCH_KNOWLEDGE_RERANKER_MODEL_ID=""
WORKBENCH_KNOWLEDGE_RERANKER_MODEL_REVISION=""
WORKBENCH_KNOWLEDGE_RERANKER_TEI_VERSION=""
WORKBENCH_KNOWLEDGE_RERANKER_MAX_INPUT_TOKENS=""
WORKBENCH_KNOWLEDGE_RERANKER_TIMEOUT_MS="30000"
WORKBENCH_KNOWLEDGE_RERANKER_MAX_REQUEST_BYTES="8388608"
WORKBENCH_KNOWLEDGE_RERANKER_MAX_RESPONSE_BYTES="1048576"
DEERFLOW_UPLOADS_ENABLED="true"
DEERFLOW_ARTIFACT_MAX_INLINE_BYTES="2000000"
# API 仅内置签到/积分领域的受控公开资料抓取；默认关闭以避免普通 Agent
# 请求产生固定外网延迟。其他领域由 DeerFlow 自身可用的搜索工具按需补充。
EXTERNAL_RESEARCH_ENABLED="false"
EXTERNAL_RESEARCH_TIMEOUT_MS="10000"
EXTERNAL_RESEARCH_CACHE_TTL_MS="21600000"
