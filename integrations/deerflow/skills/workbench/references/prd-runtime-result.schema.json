          "$ref": "#/$defs/PrdBulletListBlock"
        },
        {
          "$ref": "#/$defs/PrdOrderedListBlock"
        },
        {
          "$ref": "#/$defs/PrdTableBlock"
        },
        {
          "$ref": "#/$defs/PrdCalloutBlock"
        },
        {
          "$ref": "#/$defs/PrdGoalBlock"
        },
        {
          "$ref": "#/$defs/PrdPersonaBlock"
        },
        {
          "$ref": "#/$defs/PrdRequirementBlock"
        },
        {
          "$ref": "#/$defs/PrdAcceptanceCriterionBlock"
