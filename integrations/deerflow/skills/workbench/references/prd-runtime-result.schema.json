          "table": "#/components/schemas/PrdTableBlock",
          "callout": "#/components/schemas/PrdCalloutBlock",
          "goal": "#/components/schemas/PrdGoalBlock",
          "persona": "#/components/schemas/PrdPersonaBlock",
          "requirement": "#/components/schemas/PrdRequirementBlock",
          "acceptanceCriterion": "#/components/schemas/PrdAcceptanceCriterionBlock",
          "flow": "#/components/schemas/PrdFlowBlock",
          "risk": "#/components/schemas/PrdRiskBlock"
