# Validation-only direct ingress for a host where DNS points straight to the
# Workbench server. Production continues to use the dedicated Edge topology.

www.{$WORKBENCH_WEB_HOSTNAME} {
	redir https://{$WORKBENCH_WEB_HOSTNAME}{uri} 301
}

{$WORKBENCH_WEB_HOSTNAME} {
	# Optional validation-only routes are installed on the target host for the
	# duration of a bounded smoke and removed immediately afterwards.
	import /etc/caddy/validation.d/*.Caddyfile

	@runEvents path_regexp runEvents ^/api/v1/runs/[^/]+/events$
	handle @runEvents {
		reverse_proxy 127.0.0.1:4180 {
			header_up -Forwarded
			header_up -X-Real-IP
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Workbench-Client-IP {http.request.remote.host}
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:4180 {
			header_up -Forwarded
			header_up -X-Real-IP
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Workbench-Client-IP {http.request.remote.host}
		}
	}
}

{$WORKBENCH_PREVIEW_HOSTNAME} {
	@preview path /preview/*
	handle @preview {
		reverse_proxy 127.0.0.1:4190 {
			header_up -Forwarded
			header_up -X-Real-IP
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.remote.host}
			header_up -Cookie
			header_up -X-Workbench-Client-IP
			header_down -Set-Cookie
		}
	}

	handle {
		respond 404
	}
}

{$WORKBENCH_S3_HOSTNAME} {
	reverse_proxy 127.0.0.1:9100
}

{$WORKBENCH_IDENTITY_HOSTNAME} {
	reverse_proxy 127.0.0.1:5556
}
