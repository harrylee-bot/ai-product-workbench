# Optional future Edge topology only. The current aionbench.com validation DNS
# points directly to the approved Origin and does not use a CDN or this Edge.
WORKBENCH_WEB_HOSTNAME=aionbench.com
WORKBENCH_PREVIEW_HOSTNAME=preview.aionbench.com

# WireGuard carries all Edge-to-origin application traffic. Upload bytes use
# the separately configured browser S3/OSS origin and do not cross this proxy.
WORKBENCH_EDGE_WIREGUARD_IP=10.88.0.1
WORKBENCH_ORIGIN_WIREGUARD_IP=10.88.0.2
WORKBENCH_EDGE_WIREGUARD_ENDPOINT=REPLACE_WITH_EDGE_PUBLIC_HOST:51820
WORKBENCH_ORIGIN_HTTP_PORT=8080
WORKBENCH_EDGE_ORIGIN_AUTH_SECRET=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL
