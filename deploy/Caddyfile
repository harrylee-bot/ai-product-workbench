www.aionbench.com {
	redir https://aionbench.com{uri} 301
}

aionbench.com {
	encode gzip

	handle /knowledge {
		redir * /knowledge/ 308
	}

	handle_path /knowledge/* {
		reverse_proxy 127.0.0.1:3001
	}

	# SSE 流式生成端点（/api/chat/stream）——必须在通用 /api/* 规则前匹配
	# flush_interval -1: 禁用缓冲，每个 SSE event 立即下发
	# no gzip: SSE 不能被压缩
	# transport 超时 600s: 与 DEERFLOW_TIMEOUT_MS 一致
	handle /api/chat/stream {
		header Cache-Control "no-store, no-cache, must-revalidate, private"
		header Pragma "no-cache"
		header Expires "0"
		header X-Accel-Buffering "no"
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	@apiCacheable {
		method GET HEAD
		path_regexp apiCacheable ^/api/.*\.(?:js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|ico|webp|avif|map|pdf|docx?|xlsx?|pptx?|zip|html)$
	}
	handle @apiCacheable {
		header Cache-Control "public, max-age=2592000, immutable"
		header -Pragma
		header -Expires
		reverse_proxy 127.0.0.1:4000
	}

	handle /api/copilotkit* {
		header Cache-Control "no-store, no-cache, must-revalidate, private"
		header Pragma "no-cache"
		header Expires "0"
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/* {
		header Cache-Control "no-store, no-cache, must-revalidate, private"
		header Pragma "no-cache"
		header Expires "0"
		reverse_proxy 127.0.0.1:4000
	}

	handle /chat* {
		header Cache-Control "no-store, no-cache, must-revalidate, private"
		header Pragma "no-cache"
		header Expires "0"
		reverse_proxy 127.0.0.1:3000
	}

	handle /admin* {
		header Cache-Control "no-store, no-cache, must-revalidate, private"
		header Pragma "no-cache"
		header Expires "0"
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
