# Greenfield Workbench deployment only. Do not reuse the legacy API database URL.

# PostgreSQL 16 + pgvector. The database container is owned by this
# infrastructure-admin role; it is never passed to API/Web/Worker services.
WORKBENCH_POSTGRES_DB=workbench
WORKBENCH_POSTGRES_USER=workbench_admin
WORKBENCH_POSTGRES_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
WORKBENCH_POSTGRES_ADMIN_URL=postgresql://workbench_admin:REPLACE_WITH_URL_ENCODED_ADMIN_PASSWORD@postgres:5432/workbench

# Prisma migrations and pg-boss schema reconciliation use this dedicated role.
WORKBENCH_POSTGRES_MIGRATOR_USER=workbench_migrator
WORKBENCH_POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_PASSWORD
WORKBENCH_MIGRATOR_DATABASE_URL=postgresql://workbench_migrator:REPLACE_WITH_URL_ENCODED_MIGRATOR_PASSWORD@postgres:5432/workbench?schema=workbench

# API, Web, Preview, and all workers use this role. It has no schema CREATE
# and no RunEvent UPDATE/DELETE/TRUNCATE privilege.
WORKBENCH_POSTGRES_RUNTIME_USER=workbench_runtime
WORKBENCH_POSTGRES_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_PASSWORD
# Percent-encode reserved characters in the password before placing it in this URL.
WORKBENCH_DATABASE_URL=postgresql://workbench_runtime:REPLACE_WITH_URL_ENCODED_RUNTIME_PASSWORD@postgres:5432/workbench?schema=workbench
# Keep this file value at 0. Pass 1 in the server-deploy.sh invocation only for
# a drained hard cut that must recreate a persisted queue policy.
WORKBENCH_ALLOW_RUNTIME_QUEUE_RECREATE=0

# OpenTelemetry traces. An empty endpoint keeps tracing context active without
# making network calls. Use an internal OTLP/HTTP protobuf collector in production.
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Example: Authorization=Bearer%20REPLACE_WITH_COLLECTOR_TOKEN
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1

# Browser auth. Product username/password accounts are handled directly by
# Better Auth; the OIDC provider remains the optional enterprise SSO entry.
# The project public hostname is aionbench.com; datatoken.shop is the AI
# provider and is not a Workbench hostname or DNS target.
WORKBENCH_WEB_ORIGIN=https://aionbench.com
WORKBENCH_GRIST_ORIGIN=https://requirements.aionbench.com
WORKBENCH_GRIST_SSO_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Host and path only, without a scheme. Quartz uses this at image-build time.
WORKBENCH_KNOWLEDGE_BASE_URL=aionbench.com/knowledge
WORKBENCH_DATABASE_SCHEMA=workbench
WORKBENCH_AUTH_DB_POOL_MAX=5
# Better Auth trusts only this origin-Caddy-authenticated, nginx-overwritten
# header. Do not configure a forwarding-header fallback here.
WORKBENCH_AUTH_CLIENT_IP_HEADER=x-workbench-client-ip
# Generate with: openssl rand -base64 48
WORKBENCH_BETTER_AUTH_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET
# Product username/password login remains enabled. Public self-registration is
# separately fail-closed and must be an exact true/false value.
WORKBENCH_PUBLIC_REGISTRATION_ENABLED=false
# Enterprise SSO is disabled by default. When set to true, all three OIDC values
# become mandatory and the login page exposes the optional SSO entry.
WORKBENCH_ENTERPRISE_SSO_ENABLED=false
WORKBENCH_OIDC_PROVIDER_ISSUER=
WORKBENCH_OIDC_CLIENT_ID=
WORKBENCH_OIDC_CLIENT_SECRET=
WORKBENCH_BFF_MAX_REQUEST_BYTES=2097152
WORKBENCH_API_MAX_REQUEST_BYTES=2097152
# Ready Blob bytes are fully verified in a dedicated anonymous disk spool before
# any response stream is exposed. Compose fixes this to the API-owned volume.
WORKBENCH_READY_OBJECT_SPOOL_DIR=/var/lib/workbench-api/ready-object-spool
# The current direct-origin topology does not use a CDN or a dedicated
# Edge. These WireGuard values are reserved for a separately approved future Edge
# deployment; do not point current aionbench.com DNS at the example endpoint.
WORKBENCH_EDGE_WIREGUARD_IP=10.88.0.1
WORKBENCH_ORIGIN_WIREGUARD_IP=10.88.0.2
WORKBENCH_EDGE_WIREGUARD_ENDPOINT=REPLACE_WITH_EDGE_PUBLIC_HOST:51820
WORKBENCH_ORIGIN_HTTP_PORT=8080
# Generate independently: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
WORKBENCH_EDGE_ORIGIN_AUTH_SECRET=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL
# Keep retired invitation keys here, comma-separated, until every invitation
# signed by them has expired. Never reuse an auth, Preview, or Knowledge key.
WORKBENCH_INVITATION_TOKEN_SECRET=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
WORKBENCH_INVITATION_TOKEN_PREVIOUS_SECRETS=
WORKBENCH_INVITATION_TTL_HOURS=168
# These public destinations are compiled into the Web image. Rebuild the image
# after changing them. Invalid or empty values leave the matching menu disabled.
NEXT_PUBLIC_WORKBENCH_FEEDBACK_URL=
NEXT_PUBLIC_WORKBENCH_FORUM_URL=
NEXT_PUBLIC_WORKBENCH_PRIVACY_URL=

# DeerFlow runtime. Its dedicated Compose project joins the Workbench internal
# Docker network with the stable `deerflow` alias; Workbench services do not
# call the host-published port.
WORKBENCH_DEERFLOW_LANGGRAPH_URL=http://deerflow:8001/api
WORKBENCH_DEERFLOW_GATEWAY_URL=http://deerflow:8001
WORKBENCH_DEERFLOW_ASSISTANT_ID=lead_agent
WORKBENCH_DEERFLOW_INTERNAL_AUTH_TOKEN=REPLACE_WITH_INTERNAL_TOKEN
WORKBENCH_DEERFLOW_MODEL_CATALOG_TIMEOUT_MS=5000
WORKBENCH_DEERFLOW_READINESS_TIMEOUT_MS=5000
WORKBENCH_DEERFLOW_STREAM_MODE=messages-tuple,values
WORKBENCH_DEERFLOW_TIMEOUT_MS=600000
WORKBENCH_DEERFLOW_SUBMISSION_TIMEOUT_MS=120000
WORKBENCH_DEERFLOW_IDLE_TIMEOUT_MS=120000
WORKBENCH_RUNTIME_CONCURRENCY=2
WORKBENCH_RUNTIME_CANCELLATION_POLL_INTERVAL_MS=1000
WORKBENCH_RUNTIME_CANCELLATION_QUERY_BATCH_SIZE=100
WORKBENCH_RUNTIME_EXECUTION_LEASE_MS=45000
WORKBENCH_RUNTIME_EXECUTION_HEARTBEAT_MS=15000
WORKBENCH_RUNTIME_EXECUTION_MAX_WALL_CLOCK_MS=1800000
WORKBENCH_RUNTIME_EXECUTION_DEADLINE_CANCEL_MS=30000
WORKBENCH_RUNTIME_PROVIDER_STATE_MODE=projection-required
WORKBENCH_RUNTIME_EXECUTION_RECONCILE_INTERVAL_MS=5000
WORKBENCH_RUNTIME_EXECUTION_RECONCILE_BATCH_SIZE=100
WORKBENCH_ENVIRONMENT_ID=workbench-production
WORKBENCH_RUNTIME_WORKER_EXECUTION_PRIVATE_KEY_HOST_PATH=/srv/workbench/private/1.0.0/current/runtime-worker-execution.key
WORKBENCH_RUNTIME_WORKER_EXECUTION_PRIVATE_KEY_PATH=/run/secrets/runtime-worker-execution.key
WORKBENCH_RUNTIME_WORKER_EXECUTION_KEY_ID=sha256:REPLACE_WITH_PUBLIC_KEY_DIGEST
WORKBENCH_RUNTIME_WORKER_EXECUTION_SIGNER_ID=workbench-runtime-worker-production
WORKBENCH_KNOWLEDGE_ORIGIN_HOSTNAME=aionbench.com
WORKBENCH_KNOWLEDGE_ORIGIN_IP=host-gateway

# Direct-release DeerFlow runtime. The runtime home stays outside the checkout
# so conversation state, SQLite/WAL data, and custom skills remain private data.
WORKBENCH_APP_DIR=/srv/workbench/app
DEER_FLOW_HOME=/var/lib/workbench/deerflow/home
WORKBENCH_DEERFLOW_BASE_CONFIG_PATH=/etc/workbench/deerflow/config.base.yaml
DEER_FLOW_CONFIG_PATH=/var/lib/workbench/deerflow/config.effective.yaml
WORKBENCH_DEERFLOW_PROVIDER_ENV_FILE=/etc/workbench/deerflow/provider.env
# The external provider file is intentionally kept outside the repository. For
# this project, its non-secret routing values are:
#   WORKBENCH_DEERFLOW_PROVIDER_BASE_URL=https://datatoken.shop/v1
#   WORKBENCH_DEERFLOW_PROVIDER_MODEL=gemini-3.6-flash
WORKBENCH_DEERFLOW_HOST_PORT=2026
WORKBENCH_INTERNAL_NETWORK_NAME=workbench_workbench-internal
WORKBENCH_DEERFLOW_COMMIT=345f08be00c8a9495079b732a39b46aa9af1584e
WORKBENCH_SOURCE_COMMIT=REPLACE_WITH_40_CHARACTER_WORKBENCH_COMMIT
WORKBENCH_DEERFLOW_BASE_IMAGE_REF=registry.example.com/deerflow/deerflow@sha256:REPLACE_WITH_64_CHARACTER_BASE_DIGEST
WORKBENCH_DEERFLOW_NODE_IMAGE_REF=node:22-bookworm-slim@sha256:REPLACE_WITH_64_CHARACTER_NODE_DIGEST
# Immutable registry reference inspected by preflight. A matching RepoDigest
# must be present locally; mutable tags and image-ID-only loads are rejected.
WORKBENCH_DEERFLOW_IMAGE_REF=registry.example.com/workbench/deerflow@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_DEERFLOW_IMAGE_DIGEST=sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_DEERFLOW_SECRET_CHANNEL_ATTESTATION_PATH=/etc/workbench/deerflow/request-scoped-secrets.attestation.json

# Runtime Knowledge capability. API and Runtime Worker must share this value.
# Generate a new secret; never deploy this placeholder or reuse another product secret.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# This URL is consumed by the trusted DeerFlow tool, so it must be routable from
# the DeerFlow deployment over TLS. The gateway exposes only this scoped POST;
# a Docker-only workbench-api hostname is not valid here.
WORKBENCH_KNOWLEDGE_TOOL_URL=https://aionbench.com/api/v1/runtime/knowledge/retrieve
WORKBENCH_KNOWLEDGE_TOOL_SECRET=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
WORKBENCH_KNOWLEDGE_TOOL_MAX_TTL_SECONDS=3600
WORKBENCH_KNOWLEDGE_READINESS_TIMEOUT_MS=4000

# Live Canvas Agent capability. This is independent from auth, Knowledge, and
# Preview secrets. Only the Worker and API know the signing secret; DeerFlow
# receives one short-lived grant in the request-scoped secret channel.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WORKBENCH_CANVAS_TOOL_URL=https://aionbench.com/api/v1/runtime/canvas/tools/execute
WORKBENCH_CANVAS_VISUAL_URL=https://aionbench.com/api/v1/runtime/canvas/visuals
WORKBENCH_CANVAS_TOOL_SECRET=REPLACE_WITH_INDEPENDENT_BASE64URL_32_BYTE_SECRET
WORKBENCH_CANVAS_TOOL_MAX_TTL_SECONDS=300
WORKBENCH_CANVAS_COMMAND_TTL_SECONDS=60
WORKBENCH_CANVAS_INVOCATION_LEASE_SECONDS=30
WORKBENCH_CANVAS_EXPIRY_RECONCILIATION_BATCH_SIZE=100
WORKBENCH_CANVAS_EXPIRY_RECONCILIATION_INTERVAL_MS=5000

# File verification is a separate worker boundary. fail-closed is safe but will
# reject every novel upload; production must select clamav and provide a reachable
# clamd endpoint before enabling uploads.
WORKBENCH_FILE_VERIFY_CONCURRENCY=2
WORKBENCH_FILE_EXTRACT_CONCURRENCY=1
# Blob GC first marks an unreferenced row eligible, waits the full grace period,
# then soft-deletes the row before idempotently deleting object bytes.
WORKBENCH_BLOB_GC_CONCURRENCY=1
WORKBENCH_BLOB_GC_GRACE_MS=604800000
WORKBENCH_BLOB_GC_RECONCILIATION_INTERVAL_MS=300000
WORKBENCH_BLOB_GC_BATCH_SIZE=100
WORKBENCH_FILE_SCAN_MODE=clamav
WORKBENCH_CLAMAV_HOST=clamav.internal.example.com
WORKBENCH_CLAMAV_PORT=3310
WORKBENCH_CLAMAV_TIMEOUT_MS=120000
WORKBENCH_CLAMAV_SIGNATURE_MAX_AGE_MS=172800000
WORKBENCH_CLAMAV_STREAM_MAX_BYTES=26214400

# External Import Source worker. Queue retries are deliberately disabled;
# durable attempts and the reconciler own the bounded retry budget instead.
WORKBENCH_IMPORT_CLAMAV_STREAM_MAX_BYTES=52428800
WORKBENCH_IMPORT_CONCURRENCY=2
WORKBENCH_IMPORT_MAX_ATTEMPTS=3
WORKBENCH_IMPORT_MAX_SOURCE_BYTES=52428800
WORKBENCH_IMPORT_MAX_URL_BYTES=10485760
WORKBENCH_IMPORT_MAX_GITHUB_BYTES=52428800
# One Figma JSON blob must fit the configured ClamAV INSTREAM limit.
WORKBENCH_IMPORT_MAX_FIGMA_BYTES=26214400
# Run source manifests accept at most 50 immutable blobs.
WORKBENCH_IMPORT_MAX_GITHUB_FILES=50
WORKBENCH_IMPORT_REQUEST_TIMEOUT_MS=30000
WORKBENCH_IMPORT_MAX_REDIRECTS=3
WORKBENCH_IMPORT_STALE_RUNNING_MS=900000
WORKBENCH_IMPORT_RECONCILE_INTERVAL_MS=60000
# Public GitHub imports work without a token at provider rate limits. Figma
# imports remain unavailable until a dedicated read-only token is configured.
WORKBENCH_IMPORT_GITHUB_TOKEN=
WORKBENCH_IMPORT_FIGMA_TOKEN=
WORKBENCH_IMPORT_PENDING_BLOB_PREFIX=pending/imports
WORKBENCH_CANONICAL_BLOB_PREFIX=blobs

WORKBENCH_FILE_PARSER=docling-serve
WORKBENCH_FILE_PARSER_VERSION=docling-serve/1.26.0+docling/2.107.0+core/2.85.0+parse/7.2.0
WORKBENCH_FILE_EXTRACTION_SCHEMA_VERSION=1

# Knowledge releases can only build with a profile that already exists in the
# database and has advanced candidate -> poc -> adopted after the fixed Chinese
# evaluation. This repository intentionally does not ship an unevaluated model
# as a fake production default, and the Compose topology does not start TEI.
WORKBENCH_KNOWLEDGE_BUILD_CONCURRENCY=1
# The following release fields are for the trusted operator command documented
# in README.md. `WORKBENCH_KNOWLEDGE_WORKSPACE_ID` is empty for a global release.
# The Profile operator grant/revoke command requires explicit audited flags and
# is intentionally not configured in the long-lived Compose environment.
WORKBENCH_KNOWLEDGE_RELEASE_KEY=production
WORKBENCH_KNOWLEDGE_RELEASE_VERSION=REPLACE_WITH_POSITIVE_RELEASE_VERSION
WORKBENCH_KNOWLEDGE_WORKSPACE_ID=
WORKBENCH_KNOWLEDGE_EMBEDDING_PROFILE_ID=REPLACE_WITH_ADOPTED_PROFILE_ID
WORKBENCH_KNOWLEDGE_EMBEDDING_PROFILE_SPEC_SHA256=REPLACE_WITH_64_CHAR_LOWERCASE_SHA256
WORKBENCH_KNOWLEDGE_RETRIEVAL_PROFILE_ID=REPLACE_WITH_ADOPTED_RETRIEVAL_PROFILE_ID
# Directory containing tokenizer.json and tokenizer_config.json from the exact
# tokenizer revision pinned by the adopted EmbeddingProfile. Compose mounts it read-only.
WORKBENCH_KNOWLEDGE_TOKENIZER_HOST_DIR=/srv/workbench/models/embedding-tokenizer
WORKBENCH_KNOWLEDGE_TOKENIZER_MAX_FILE_BYTES=134217728
WORKBENCH_TEI_URL=https://tei.internal.example.com
# Leave empty when the internal service uses a different authenticated network boundary.
WORKBENCH_TEI_API_KEY=
WORKBENCH_TEI_IMAGE_DIGEST=sha256:REPLACE_WITH_64_CHAR_LOWERCASE_IMAGE_DIGEST
WORKBENCH_TEI_REQUEST_TIMEOUT_MS=30000
WORKBENCH_TEI_MAX_REQUEST_BYTES=8388608
WORKBENCH_TEI_MAX_RESPONSE_BYTES=33554432

# Independent production reranker. All identity fields are immutable pins and
# are verified against TEI /info by API readiness when a ready release exists.
WORKBENCH_KNOWLEDGE_RERANKER_URL=https://reranker.internal.example.com
WORKBENCH_KNOWLEDGE_RERANKER_API_KEY=
WORKBENCH_KNOWLEDGE_RERANKER_IMAGE_DIGEST=sha256:REPLACE_WITH_64_CHAR_LOWERCASE_IMAGE_DIGEST
WORKBENCH_KNOWLEDGE_RERANKER_MODEL_ID=REPLACE_WITH_RERANKER_MODEL_ID
WORKBENCH_KNOWLEDGE_RERANKER_MODEL_REVISION=REPLACE_WITH_IMMUTABLE_MODEL_REVISION
WORKBENCH_KNOWLEDGE_RERANKER_TEI_VERSION=REPLACE_WITH_PINNED_TEI_VERSION
WORKBENCH_KNOWLEDGE_RERANKER_MAX_INPUT_TOKENS=REPLACE_WITH_EVALUATED_TOKEN_LIMIT
WORKBENCH_KNOWLEDGE_RERANKER_TIMEOUT_MS=30000
WORKBENCH_KNOWLEDGE_RERANKER_MAX_REQUEST_BYTES=8388608
WORKBENCH_KNOWLEDGE_RERANKER_MAX_RESPONSE_BYTES=1048576

# Docling Serve is an isolated parser service. The supplied local image is
# pinned to the v1.26.0 multi-architecture index digest. Production may use an
# independently operated endpoint, but it must use the same replayable contract.
WORKBENCH_DOCLING_URL=http://docling:5001
WORKBENCH_DOCLING_API_KEY=REPLACE_WITH_INTERNAL_DOCLING_TOKEN
WORKBENCH_DOCLING_RESULTS_REPLAYABLE=true
WORKBENCH_DOCLING_SUBMIT_TIMEOUT_MS=120000
WORKBENCH_DOCLING_POLL_TIMEOUT_MS=15000
WORKBENCH_DOCLING_RESULT_RETENTION_SECONDS=86400
WORKBENCH_DOCLING_REAPER_INTERVAL_MS=3600000
WORKBENCH_DOCLING_IMAGE=ghcr.io/docling-project/docling-serve-cpu:v1.26.0@sha256:7e07522e0240c1db3ff5b837ffa969c2ecd5a71664c0e0369f5a69fc169e30ba

# Approved S3-compatible object storage. Services use the private/internal
# endpoint; browsers receive signatures for the separate, routable bucket URL.
# A virtual-hosted custom domain points at the bucket root; path-style providers
# include the bucket name in this URL instead.
# The bucket must abort incomplete multipart uploads. Application-owned object
# prefixes, including `canvas-visuals/*`, must not have provider-side expiry;
# database cleanup deletes them only after any forensic hold is released.
WORKBENCH_S3_INTERNAL_ENDPOINT=https://s3.internal.example.com
WORKBENCH_S3_EGRESS_UPSTREAM_HOST=s3.internal.example.com
WORKBENCH_S3_BROWSER_UPLOAD_BUCKET_URL=https://uploads.aionbench.com
WORKBENCH_S3_BUCKET=workbench
WORKBENCH_S3_REGION=us-east-1
WORKBENCH_S3_INTERNAL_FORCE_PATH_STYLE=false
# Use oss-forbid-overwrite for Alibaba Cloud OSS; other S3 providers use the default.
WORKBENCH_S3_CONDITIONAL_CREATE_MODE=s3-if-none-match

# API upload control-plane identity: multipart operations and HeadObject only
# under `staging/files/*`. It must not read canonical or quarantine objects.
WORKBENCH_API_STAGING_S3_ACCESS_KEY_ID=REPLACE_WITH_API_STAGING_ACCESS_KEY
WORKBENCH_API_STAGING_S3_SECRET_ACCESS_KEY=REPLACE_WITH_API_STAGING_SECRET_KEY

# API ready-Blob reader: GetObject only under canonical `blobs/*` keys selected
# from authorized ready database rows. It must not access staging/quarantine.
WORKBENCH_API_READY_BLOB_S3_ACCESS_KEY_ID=REPLACE_WITH_API_READY_BLOB_READ_ACCESS_KEY
WORKBENCH_API_READY_BLOB_S3_SECRET_ACCESS_KEY=REPLACE_WITH_API_READY_BLOB_READ_SECRET_KEY

# API Canvas visual identity: PutObject/GetObject/DeleteObject only under the
# short-lived `canvas-visuals/*` prefix. It must not access any Blob namespace.
WORKBENCH_API_CANVAS_VISUAL_S3_ACCESS_KEY_ID=REPLACE_WITH_API_CANVAS_VISUAL_ACCESS_KEY
WORKBENCH_API_CANVAS_VISUAL_S3_SECRET_ACCESS_KEY=REPLACE_WITH_API_CANVAS_VISUAL_SECRET_KEY

# Runtime source reader: GetObject only under canonical `blobs/*` keys
# captured in immutable Run source snapshots.
WORKBENCH_RUNTIME_READY_BLOB_S3_ACCESS_KEY_ID=REPLACE_WITH_RUNTIME_READY_BLOB_READ_ACCESS_KEY
WORKBENCH_RUNTIME_READY_BLOB_S3_SECRET_ACCESS_KEY=REPLACE_WITH_RUNTIME_READY_BLOB_READ_SECRET_KEY

# File pipeline identity: verify/extract staging and ready objects, publish
# canonical/quarantine objects, and delete only after the durable GC fence.
WORKBENCH_FILE_PIPELINE_S3_ACCESS_KEY_ID=REPLACE_WITH_FILE_PIPELINE_ACCESS_KEY
WORKBENCH_FILE_PIPELINE_S3_SECRET_ACCESS_KEY=REPLACE_WITH_FILE_PIPELINE_SECRET_KEY

# Import Worker identity: create deterministic `blobs/*` objects only after a
# clean scan, plus its private `pending/imports/*` staging namespace. It must not
# receive API staging, File pipeline, Runtime, Export, or Preview credentials.
WORKBENCH_IMPORT_S3_ACCESS_KEY_ID=REPLACE_WITH_IMPORT_WORKER_ACCESS_KEY
WORKBENCH_IMPORT_S3_SECRET_ACCESS_KEY=REPLACE_WITH_IMPORT_WORKER_SECRET_KEY

# Export runs in a no-egress Chromium worker. Its worker identity may read ready
# `blobs/*`, create `pending/exports/*`, and publish only deterministic canonical
# `blobs/*` outputs.
WORKBENCH_EXPORT_S3_ACCESS_KEY_ID=REPLACE_WITH_EXPORT_WORKER_ACCESS_KEY
WORKBENCH_EXPORT_S3_SECRET_ACCESS_KEY=REPLACE_WITH_EXPORT_WORKER_SECRET_KEY
WORKBENCH_EXPORT_CONCURRENCY=1
WORKBENCH_EXPORT_MAX_INPUT_BYTES=52428800
WORKBENCH_EXPORT_MAX_OUTPUT_BYTES=52428800
WORKBENCH_EXPORT_BROWSER_TIMEOUT_MS=20000
WORKBENCH_EXPORT_RECONCILE_INTERVAL_MS=60000
WORKBENCH_EXPORT_STALE_RUNNING_MS=1200000

# Preview must terminate on a distinct origin so it never receives main-site
# cookies. Generate the token secret with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WORKBENCH_PREVIEW_ORIGIN=https://preview.aionbench.com
WORKBENCH_PREVIEW_GATEWAY_PORT=4190
WORKBENCH_PREVIEW_TOKEN_SECRET=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
WORKBENCH_PREVIEW_TOKEN_MAX_TTL_SECONDS=3600
WORKBENCH_PREVIEW_MAX_HTML_BYTES=52428800
WORKBENCH_PREVIEW_MAX_CONCURRENCY=4
# The Compose service mounts a dedicated disk-backed volume at this path.
WORKBENCH_PREVIEW_SPOOL_DIR=/var/lib/workbench-preview
WORKBENCH_PREVIEW_S3_ACCESS_KEY_ID=REPLACE_WITH_PREVIEW_READ_ONLY_ACCESS_KEY
WORKBENCH_PREVIEW_S3_SECRET_ACCESS_KEY=REPLACE_WITH_PREVIEW_READ_ONLY_SECRET_KEY

# Storage IAM policy is part of the security boundary. Every credential above is
# mandatory and role-specific; services never fall back to a generic/ambient key:
# - API ready Blob / Runtime credentials: read `blobs/*` only
# - API Canvas visual credentials: create/read/delete `canvas-visuals/*` only
# - API staging signer: multipart operations under `staging/files/*` only
# - File Worker: read/delete staging, create Blob/quarantine objects, and delete
#   only canonical/quarantine objects whose Blob row passed the durable-reference GC fence
# - Import Worker: create `pending/imports/*` and content-addressed `blobs/*`;
#   it cannot read API staging or quarantine namespaces
# - Export Worker: read ready blobs, create `pending/exports/*`, publish generated `blobs/*`
# - Preview: read only Blob keys referenced by succeeded HTML ExportJobs
# No browser, API or Runtime credential may read `quarantine/blobs/*`.

# Gateway and image overrides
WORKBENCH_GATEWAY_PORT=4180
WORKBENCH_WEB_IMAGE_REF=registry.example.com/workbench/web@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_API_IMAGE_REF=registry.example.com/workbench/api@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_API_MIGRATOR_IMAGE_REF=registry.example.com/workbench/api-migrator@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_RUNTIME_WORKER_IMAGE_REF=registry.example.com/workbench/runtime-worker@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_FILE_WORKER_IMAGE_REF=registry.example.com/workbench/file-worker@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_IMPORT_WORKER_IMAGE_REF=registry.example.com/workbench/import-worker@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_EXPORT_WORKER_IMAGE_REF=registry.example.com/workbench/export-worker@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_PREVIEW_IMAGE_REF=registry.example.com/workbench/preview@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
WORKBENCH_KNOWLEDGE_IMAGE_REF=registry.example.com/workbench/quartz@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
# Direct production preflight requires this value to be replaced with
# node:22-alpine@sha256:<64hex>.
WORKBENCH_NODE_IMAGE=node:22-alpine
WORKBENCH_POSTGRES_IMAGE=pgvector/pgvector:pg16@sha256:REPLACE_WITH_64_CHARACTER_POSTGRES_DIGEST
WORKBENCH_NGINX_IMAGE=nginx:stable-alpine@sha256:REPLACE_WITH_64_CHARACTER_NGINX_DIGEST
WORKBENCH_QUARTZ_REF=v5.0.0
WORKBENCH_QUARTZ_COMMIT=ab346fa66a895e12d63a308e70ce330ba795822a

# Local development only:
#   1. Set WORKBENCH_S3_INTERNAL_ENDPOINT=http://object-storage:9000,
#      WORKBENCH_S3_BROWSER_UPLOAD_BUCKET_URL=http://127.0.0.1:9000/workbench,
#      and WORKBENCH_S3_INTERNAL_FORCE_PATH_STYLE=true.
#   2. Provision the eight role-specific credentials above in local MinIO. For a
#      disposable single-user laptop only, they may all use the local MinIO root
#      pair; never reuse that shortcut in a shared or production environment.
#   3. Run docker compose --env-file deploy/workbench.env \
#        -f deploy/workbench-compose.yml --profile local-object-storage \
#        --profile local-docling up
# MinIO is AGPL-3.0 and is not enabled by the default production topology.
WORKBENCH_MINIO_ROOT_USER=REPLACE_WITH_LOCAL_MINIO_ROOT_USER
WORKBENCH_MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_MINIO_ROOT_PASSWORD
# Local-object-storage profile fallbacks only. Production forbids this profile;
# if it is used for an approved local host, pin both images to @sha256.
WORKBENCH_MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
WORKBENCH_MINIO_MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z

# Optional identity hostname for enterprise SSO; when enabled, it must match
# the hostname in WORKBENCH_OIDC_PROVIDER_ISSUER.
WORKBENCH_IDENTITY_HOSTNAME=
WORKBENCH_LOCAL_S3_BIND_ADDRESS=127.0.0.1
WORKBENCH_LOCAL_S3_PORT=9100
