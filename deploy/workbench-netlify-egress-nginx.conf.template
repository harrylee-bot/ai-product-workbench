worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 256;
}

stream {
  resolver 127.0.0.11 valid=300s ipv6=off;
  resolver_timeout 5s;

  server {
    listen 443;
    set $netlify_upstream "${WORKBENCH_NETLIFY_EGRESS_TARGET_HOST}:443";
    proxy_connect_timeout 10s;
    proxy_timeout 180s;
    proxy_pass $netlify_upstream;
  }
}
