{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/evidence/ledger.schema.json",
  "title": "Product Workbench immutable evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "payload",
    "payloadSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "workbench.evidence-ledger.v1"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "payloadSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ledgerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerId",
        "uri",
        "sha256"
      ],
      "properties": {
        "ledgerId": {
          "$ref": "#/$defs/identifier"
        },
        "uri": {
          "type": "string",
          "pattern": "^file:\\.\\/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "imageDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "images",
        "configSha256",
        "migrationSha256",
        "deploymentConfigManifestSha256",
        "imageManifestSha256",
        "controlCatalogSha256"
      ],
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imageDigest"
          }
        },
        "configSha256": {
          "$ref": "#/$defs/sha256"
        },
        "migrationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "deploymentConfigManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "imageManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "controlCatalogSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "deployId",
        "environmentId",
        "commitSha",
        "tag",
        "releaseChainId",
        "digests"
      ],
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/identifier"
        },
        "deployId": {
          "$ref": "#/$defs/identifier"
        },
        "environmentId": {
          "$ref": "#/$defs/identifier"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tag": {
          "$ref": "#/$defs/identifier"
        },
        "releaseChainId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "digests": {
          "$ref": "#/$defs/digests"
        },
        "candidateManifest": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "ledgerBinding": {
      "$ref": "#/$defs/binding"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId",
        "kind",
        "description"
      ],
      "properties": {
        "environmentId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "local",
            "ci",
            "server",
            "staging",
            "production"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "procedure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "command"
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "steps"
          ],
          "properties": {
            "kind": {
              "const": "steps"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      ]
    },
    "threshold": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operator",
            "expected"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "operator": {
              "const": "eq"
            },
            "expected": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operator",
            "expected"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "operator": {
              "enum": [
                "eq",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "expected": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "person",
            "auditor",
            "ci",
            "automation"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "toolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "executedAtUtc",
        "executionStatus",
        "reason",
        "evidence"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "executedAtUtc": {
          "$ref": "#/$defs/utc"
        },
        "executionStatus": {
          "$ref": "#/$defs/executionStatus"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "finding",
            "decision"
          ]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "notApplicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeBasis",
        "approver",
        "expiresAtUtc"
      ],
      "properties": {
        "scopeBasis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "approver": {
          "$ref": "#/$defs/identifier"
        },
        "expiresAtUtc": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "executionStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT RUN",
        "BLOCKED",
        "INCONCLUSIVE",
        "N/A"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "gateId",
        "controlObjective",
        "environment",
        "prerequisites",
        "procedure",
        "expectedObservation",
        "threshold",
        "findingStatus",
        "executionStatus",
        "evidenceLevel",
        "executedAtUtc",
        "executor",
        "binding",
        "toolVersions",
        "evidence",
        "retryRecords",
        "relatedFindingsOrDecisions"
      ],
      "properties": {
        "entryId": {
          "$ref": "#/$defs/identifier"
        },
        "gateId": {
          "$ref": "#/$defs/identifier"
        },
        "controlObjective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "procedure": {
          "$ref": "#/$defs/procedure"
        },
        "expectedObservation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "threshold": {
          "$ref": "#/$defs/threshold"
        },
        "findingStatus": {
          "enum": [
            "CONFIRMED",
            "PLAUSIBLE",
            "REFUTED"
          ]
        },
        "executionStatus": {
          "$ref": "#/$defs/executionStatus"
        },
        "evidenceLevel": {
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "executedAtUtc": {
          "$ref": "#/$defs/utc"
        },
        "executor": {
          "$ref": "#/$defs/executor"
        },
        "binding": {
          "allOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "not": {
                "type": "object",
                "properties": {
                  "candidateManifest": true
                },
                "required": [
                  "candidateManifest"
                ]
              }
            }
          ]
        },
        "toolVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/toolVersion"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "retryRecords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retry"
          }
        },
        "relatedFindingsOrDecisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/related"
          }
        },
        "notApplicable": {
          "$ref": "#/$defs/notApplicable"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "executionStatus": {
                "const": "N/A"
              }
            }
          },
          "then": {
            "properties": {
              "notApplicable": {
                "$ref": "#/$defs/notApplicable"
              }
            },
            "required": [
              "notApplicable"
            ]
          },
          "else": {
            "properties": {
              "notApplicable": false
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerId",
        "createdAtUtc",
        "binding",
        "previousLedger",
        "entries"
      ],
      "properties": {
        "ledgerId": {
          "$ref": "#/$defs/identifier"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/utc"
        },
        "binding": {
          "$ref": "#/$defs/ledgerBinding"
        },
        "previousLedger": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ledgerReference"
            }
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    }
  }
}
