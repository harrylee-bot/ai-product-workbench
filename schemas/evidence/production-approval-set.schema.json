{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionbench.com/schemas/workbench.production-approval-set.v1.json",
  "title": "Product Workbench production approval set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvals"],
  "properties": {
    "schemaVersion": { "const": "workbench.production-approval-set.v1" },
    "approvals": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/approval" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "decision", "approverId", "signedAtUtc", "evidencePath", "evidenceSha256", "signature"],
      "properties": {
        "role": { "enum": ["Security", "Data", "Operations", "Release"] },
        "decision": { "const": "APPROVE" },
        "approverId": { "$ref": "#/$defs/identifier" },
        "signedAtUtc": { "$ref": "#/$defs/utc" },
        "evidencePath": { "$ref": "#/$defs/path" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "keyId", "value"],
          "properties": {
            "algorithm": { "const": "Ed25519" },
            "keyId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
          }
        }
      }
    }
  }
}
