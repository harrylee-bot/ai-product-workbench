{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionbench.com/schemas/workbench.production-deployment-configuration.v1.json",
  "title": "Product Workbench signed production deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidate", "workflowRun", "productionImages", "configurationSha256", "sourceConfiguration", "effectiveConfig", "secretVersions", "identity", "dependencies", "migrations", "payloadSha256"],
  "properties": {
    "schemaVersion": { "const": "workbench.production-deployment-configuration.v1" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "sourceCommit", "signedTag", "releaseChainId"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/prefixedSha256" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "signedTag": { "$ref": "#/$defs/identifier" },
        "releaseChainId": { "$ref": "#/$defs/prefixedSha256" }
      }
    },
    "workflowRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "productionImages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "images"],
      "properties": {
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "images": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/imageDigest" } }
      }
    },
    "configurationSha256": { "$ref": "#/$defs/sha256" },
    "sourceConfiguration": { "$ref": "#/$defs/tree" },
    "effectiveConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "values"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "secretVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "entries"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/secretVersion" } }
      }
    },
    "identity": { "$ref": "#/$defs/identity" },
    "dependencies": {
      "type": "array",
      "minItems": 8,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "migrations": { "$ref": "#/$defs/tree" },
    "payloadSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prefixedSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "files"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "imageDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/prefixedSha256" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "endpoint", "version", "imageRef", "digest", "configAttestationSha256"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["deployed-image", "external-service"] },
        "endpoint": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "imageRef": { "type": ["string", "null"] },
        "digest": { "type": ["string", "null"] },
        "configAttestationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "secretVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "attestationSha256"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/identifier" },
        "attestationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterpriseSsoEnabled", "provider"],
      "properties": {
        "enterpriseSsoEnabled": { "type": "boolean" },
        "provider": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["issuer", "identityHostname", "clientIdSha256"],
              "properties": {
                "issuer": { "type": "string", "pattern": "^https://" },
                "identityHostname": { "type": "string", "minLength": 1 },
                "clientIdSha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      }
    }
  }
}
