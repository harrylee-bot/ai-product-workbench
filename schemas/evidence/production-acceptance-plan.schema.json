{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionbench.com/schemas/workbench.production-acceptance-plan.v1.json",
  "title": "Product Workbench production acceptance plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payload", "payloadSha256"],
  "properties": {
    "schemaVersion": { "const": "workbench.production-acceptance-plan.v1" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "createdAtUtc", "plannerId", "catalog", "deploymentConfig", "binding", "environment", "gates"],
      "properties": {
        "planId": { "$ref": "#/$defs/identifier" },
        "createdAtUtc": { "$ref": "#/$defs/utc" },
        "plannerId": { "$ref": "#/$defs/identifier" },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "catalogId", "sha256"],
          "properties": {
            "schemaVersion": { "const": "workbench.production-acceptance-control-catalog.v1" },
            "catalogId": { "$ref": "#/$defs/identifier" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "deploymentConfig": { "$ref": "#/$defs/deploymentConfig" },
        "binding": { "$ref": "#/$defs/binding" },
        "environment": { "$ref": "#/$defs/environment" },
        "gates": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gateId", "controls"],
            "properties": {
              "gateId": { "enum": ["G5", "G6", "G7", "G8", "G9", "G10", "G11"] },
              "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } }
            }
          }
        }
      }
    },
    "payloadSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prefixedSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$" },
    "commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/prefixedSha256" }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "configSha256", "migrationSha256", "deploymentConfigManifestSha256", "imageManifestSha256", "controlCatalogSha256"],
      "properties": {
        "images": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/image" } },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "migrationSha256": { "$ref": "#/$defs/sha256" },
        "deploymentConfigManifestSha256": { "$ref": "#/$defs/sha256" },
        "imageManifestSha256": { "$ref": "#/$defs/sha256" },
        "controlCatalogSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "endpoint", "version", "imageRef", "digest", "configAttestationSha256"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["deployed-image", "external-service"] },
        "endpoint": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "imageRef": { "type": ["string", "null"] },
        "digest": { "type": ["string", "null"] },
        "configAttestationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterpriseSsoEnabled", "provider"],
      "properties": {
        "enterpriseSsoEnabled": { "type": "boolean" },
        "provider": { "type": ["object", "null"] }
      }
    },
    "deploymentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "manifestSha256", "configSha256", "migrationSha256", "effectiveConfigSha256", "secretVersionsSha256", "identity", "dependencies"],
      "properties": {
        "schemaVersion": { "const": "workbench.production-deployment-configuration.v1" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "migrationSha256": { "$ref": "#/$defs/sha256" },
        "effectiveConfigSha256": { "$ref": "#/$defs/sha256" },
        "secretVersionsSha256": { "$ref": "#/$defs/sha256" },
        "identity": { "$ref": "#/$defs/identity" },
        "dependencies": { "type": "array", "minItems": 8, "maxItems": 9, "items": { "$ref": "#/$defs/dependency" } }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "deployId", "environmentId", "commitSha", "tag", "releaseChainId", "digests"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/prefixedSha256" },
        "deployId": { "$ref": "#/$defs/identifier" },
        "environmentId": { "$ref": "#/$defs/identifier" },
        "commitSha": { "$ref": "#/$defs/commit" },
        "tag": { "$ref": "#/$defs/identifier" },
        "releaseChainId": { "$ref": "#/$defs/prefixedSha256" },
        "digests": { "$ref": "#/$defs/digests" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentId", "kind", "description", "region"],
      "properties": {
        "environmentId": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "production" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "region": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
