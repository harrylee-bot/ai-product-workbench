{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionbench.com/schemas/workbench.production-observation-source.v1.json",
  "title": "Product Workbench production observation source bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": { "const": "workbench.production-observation-source.v1" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "contentBase64"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?:observations|raw)/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "contentBase64": { "type": "string" }
        }
      }
    }
  }
}
