{
  "name": "@workbench/workbench-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ../../scripts/workbench-api-dev.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:knowledge-postgres": "vitest run test/knowledge-retrieval.postgres.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.896.0",
    "@aws-sdk/s3-request-presigner": "3.896.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@workbench/workbench-canvas-tools": "1.0.0",
    "@workbench/workbench-content-security": "1.0.0",
    "@workbench/workbench-contracts": "1.0.0",
    "@workbench/workbench-db": "1.0.0",
    "@workbench/workbench-knowledge": "1.0.0",
    "@workbench/workbench-preview-token": "1.0.0",
    "@workbench/workbench-telemetry": "1.0.0",
    "express": "5.2.1",
    "helmet": "^8.2.0",
    "jieba-wasm": "2.4.0",
    "jwks-rsa": "^3.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg-boss": "12.26.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-libvips-linuxmusl-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5",
    "@img/sharp-linuxmusl-x64": "0.35.5"
  }
