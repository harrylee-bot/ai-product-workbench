{
  "name": "@workbench/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo --hostname localhost --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "generate:workbench-api": "openapi-typescript ../../packages/workbench-contracts/openapi/workbench.v1.yaml -o lib/workbench/api/schema.d.ts",
    "test": "vitest run --config vitest.workbench.config.ts",
    "test:watch": "vitest --config vitest.workbench.config.ts",
    "typegen": "node ../../scripts/workbench-web-typegen.mjs",
    "typecheck": "npm run typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:workbench": "eslint 'app/(auth)' 'app/(invitation)' 'app/(workbench)' app/share components/auth components/share components/workbench lib/workbench",
    "architecture:workbench": "depcruise --config ../../.dependency-cruiser.cjs 'app/(auth)' 'app/(invitation)' 'app/(workbench)' app/share components/auth components/share components/workbench lib/workbench"
  },
