{
  "name": "@workbench/workbench-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "node ../../scripts/assert-runtime-provider-state-test-database.mjs && vitest run test/runtime-attempt.postgres.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.896.0",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph-sdk": "1.9.25",
    "@workbench/workbench-canvas-tools": "1.0.0",
    "@workbench/workbench-content-security": "1.0.0",
    "@workbench/workbench-contracts": "1.0.0",
    "@workbench/workbench-db": "1.0.0",
    "@workbench/workbench-knowledge": "1.0.0",
    "@workbench/workbench-telemetry": "1.0.0",
    "form-data": "4.0.6",
    "partial-json": "0.1.7",
    "pg-boss": "12.26.0",
    "uuid": "14.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "4.1.12"
  }
}
