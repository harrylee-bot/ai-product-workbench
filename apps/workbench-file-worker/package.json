    "file-type": "22.0.1",
    "form-data": "4.0.6",
    "jieba-wasm": "2.4.0",
    "pg-boss": "12.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
