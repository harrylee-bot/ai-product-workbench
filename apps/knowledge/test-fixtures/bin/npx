#!/usr/bin/env bash
set -euo pipefail

: "${QUARTZ_TEST_BUILD_COUNT_FILE:?QUARTZ_TEST_BUILD_COUNT_FILE is required}"

count=0
if [ -f "$QUARTZ_TEST_BUILD_COUNT_FILE" ]; then
  count="$(cat "$QUARTZ_TEST_BUILD_COUNT_FILE")"
fi
count=$((count + 1))
printf '%s\n' "$count" > "$QUARTZ_TEST_BUILD_COUNT_FILE"

active_dir="${QUARTZ_TEST_BUILD_COUNT_FILE}.active"
owns_active=false
if mkdir "$active_dir" 2>/dev/null; then
  owns_active=true
  printf '%s\n' "$$" > "$active_dir/pid"
else
  : > "${QUARTZ_TEST_BUILD_COUNT_FILE}.overlap"
fi

cleanup() {
  if [ "$owns_active" = true ]; then rm -rf "$active_dir"; fi
}
trap cleanup EXIT
trap 'exit 143' TERM INT

directory=""
output=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --directory)
      directory="$2"
      shift 2
      ;;
    --output)
      output="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

[ -n "$directory" ] && [ -n "$output" ]
if [ -n "${QUARTZ_TEST_DELAY_FILE:-}" ] && [ -s "$QUARTZ_TEST_DELAY_FILE" ]; then
  sleep "$(cat "$QUARTZ_TEST_DELAY_FILE")"
fi
mkdir -p "$output"
if [ -n "${QUARTZ_TEST_FAIL_FILE:-}" ] && [ -e "$QUARTZ_TEST_FAIL_FILE" ]; then
  printf 'partial build\n' > "$output/partial.txt"
  exit 42
fi

printf '<!doctype html><html><body>Build %s</body></html>\n' "$count" > "$output/index.html"
