{
  "extends": "@create-figma-plugin/tsconfig",
  "compilerOptions": {
    "typeRoots": [
      "../../node_modules/@figma",
      "../../node_modules/@types"
    ],
    "types": [],
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts"
  ],
  "files": ["../../node_modules/@figma/plugin-typings/index.d.ts"]
}
