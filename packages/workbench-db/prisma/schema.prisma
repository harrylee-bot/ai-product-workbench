generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("WORKBENCH_DATABASE_URL")
}

enum PrincipalStatus {
  active
  disabled
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum ProjectStatus {
  active
  archived
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum ProjectInvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum InvitationDeliveryStatus {
  not_configured
}

enum ThreadStatus {
  active
  archived
}

enum ThreadEntryRole {
  user
  assistant
  system
}

enum ThreadEntryKind {
  message
  activity
  approval
}

enum RunStatus {
  queued
  running
  waiting_input
  cancelling
  succeeded
  failed
  cancelled
}

enum RunPhase {
  understanding
  retrieving_knowledge
  planning
  generating
  validating
  publishing
}

enum SubmissionIntentStatus {
  pending
  submitting
  submitted
  cancelled
}

enum SubmissionIntentAttachmentKind {
  existing
  upload
}

enum RuntimeAttemptStatus {
  pending
  submitting
  submission_unknown
  running
  waiting_input
  cancelling
  succeeded
  failed
  cancelled
}

enum RuntimeExternalEventStatus {
  pending
  processed
}

enum KnowledgeRetrievalInvocationStatus {
  in_flight
  succeeded
  failed
  discarded
  abandoned
}

enum ApprovalStatus {
  pending
  approved
  rejected
  submitted
  expired
}

enum CanvasAgentSessionStatus {
  active
  completed
  cancelled
  expired
}

enum CanvasToolInvocationStatus {
  in_flight
  waiting_client
  succeeded
  waiting_approval
  failed
  cancelled
}

enum CanvasClientCommandStatus {
  pending
  acknowledged
  expired
  cancelled
}

enum CanvasVisualCapabilityStatus {
  pending
  ready
  failed
  expired
}

enum ArtifactKind {
  prd
  prototype
  image
  code
  document
  data
  design_system
}

enum ArtifactVersionStatus {
  staging
  ready
  rejected
}

enum PrototypePatchProjectionStatus {
  active
  paused
  degraded
  finalized
  discarded
}

enum PrototypePatchApplicationOutcome {
  applied
  degraded
}

enum ArtifactVersionReaction {
  like
  dislike
}

enum BlobStatus {
  pending
  ready
  quarantined
  deleted
}

enum FileStatus {
  uploading
  verifying
  ready
  failed
  quarantined
  deleted
}

enum FileUploadStatus {
  initiating
  initiated
  completing
  completed
  aborting
  aborted
  expired
  failed
}

enum FileExtractionStatus {
  queued
  running
  ready
  unsupported
  failed
}

enum ImportSourceKind {
  file
  design_md
  url_snapshot
  github_snapshot
  figma_snapshot
}

enum ImportSourceStatus {
  pending
  ready
  failed
  deleted
}

enum ImportSourceAttemptStatus {
  queued
  running
  succeeded
  retryable_failed
  terminal_failed
}

enum BlobScanStatus {
  queued
  running
  clean
  infected
  failed
}

enum FileVerificationAttemptStatus {
  running
  succeeded
  retryable_failed
  terminal_failed
}

enum ShareScope {
  view
  remix
}

enum ShareStatus {
  active
  revoked
  expired
}

enum ExportStatus {
  queued
  running
  cancelling
  succeeded
  failed
  cancelled
}

enum ExportJobPurpose {
  export
  preview
}

enum ProjectReleaseStatus {
  building
  ready
  failed
}

enum ExportFormat {
  html
  react
  figma
  mcp
  docx
  pdf
}

enum ExportPackaging {
  single_file
  zip
}

enum ExternalExportTarget {
  ai_studio
  netlify
  lovable
  bolt
}

enum ExternalExportAuthentication {
  not_required
  required
  authenticated
}

enum ExternalExportDeliveryStatus {
  pending_confirmation
  queued
  running
  cancelling
  succeeded
  failed
  cancelled
}

enum ExportSelectionKind {
  release
  board
  board_nodes
  artifact
}

enum KnowledgeReleaseStatus {
  building
  ready
  failed
  retired
}

enum KnowledgeSourceKind {
  vault_markdown
  storage_asset
  project_upload
}

enum KnowledgeRoute {
  production
  source_lookup
  excluded
  quarantine
}

enum EmbeddingProfileStatus {
  candidate
  poc
  adopted
  retired
}

enum RetrievalProfileStatus {
  candidate
  poc
  adopted
  retired
}

enum KnowledgeProfileKind {
  embedding
  retrieval
}

enum KnowledgeProfileScope {
  global
}

enum KnowledgeProfileOperatorAction {
  grant
  revoke
}

enum KnowledgeEmbeddingBatchStatus {
  pending
  running
  ready
  failed
}

// Better Auth owns only these technical identity/session tables. Workbench
// authorization remains in Principal, WorkspaceMember, and ProjectMember.
model AuthUser {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String        @unique
  username        String?       @unique
  displayUsername String?       @map("display_username")
  emailVerified   Boolean       @map("email_verified")
  image           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions        AuthSession[]
  accounts        AuthAccount[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(6)
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthJwk {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)

  @@map("auth_jwks")
}

model Principal {
  id                              String                            @id @default(cuid())
  issuer                          String
  subject                         String
  email                           String?
  displayName                     String?                           @map("display_name")
  status                          PrincipalStatus                   @default(active)
  createdAt                       DateTime                          @default(now()) @map("created_at")
  updatedAt                       DateTime                          @updatedAt @map("updated_at")
  memberships                     WorkspaceMember[]
  projectMemberships              ProjectMember[]
  createdWorkspaces               Workspace[]                       @relation("WorkspaceCreator")
  createdProjects                 Project[]                         @relation("ProjectCreator")
  createdThreads                  Thread[]                          @relation("ThreadCreator")
  createdRuns                     Run[]
  runCancellationReceipts         RunCancellationReceipt[]           @relation("RunCancellationReceiptPrincipal")
  createdSubmissionIntents        SubmissionIntent[]                @relation("SubmissionIntentCreator")
  uploadedFiles                   FileAsset[]                       @relation("FileUploader")
  createdShares                   ShareGrant[]                      @relation("ShareCreator")
  createdReleases                 ProjectRelease[]                  @relation("ProjectReleaseCreator")
  createdExports                  ExportJob[]                       @relation("ExportCreator")
  createdExternalExportDeliveries ExternalExportDelivery[]          @relation("ExternalExportDeliveryCreator")
  createdPreviews                 ProjectPreview[]                  @relation("PreviewCreator")
  createdLineages                 ProjectLineage[]                  @relation("ProjectLineageCreator")
  createdDuplicates               ProjectDuplicate[]                @relation("ProjectDuplicateCreator")
  designSystemImports             DesignSystemImport[]              @relation("DesignSystemImportCreator")
  designSystemCreations           DesignSystemCreation[]            @relation("DesignSystemCreationCreator")
  boardReplacements               BoardReplaceReceipt[]             @relation("BoardReplaceCreator")
  artifactVersionEdits            ArtifactVersionEditReceipt[]      @relation("ArtifactVersionEditCreator")
  artifactCreations               ArtifactCreationReceipt[]         @relation("ArtifactCreationCreator")
  decidedApprovals                RunApproval[]                     @relation("ApprovalDecider")
  canvasAgentSessions             CanvasAgentSession[]              @relation("CanvasAgentSessionPrincipal")
  artifactVersionPreferences      ArtifactVersionPreference[]
  communicationPreferences        PrincipalCommunicationPreference?
  knowledgeToolGrants             KnowledgeToolGrant[]              @relation("KnowledgeToolGrantPrincipal")
  knowledgeProfileOperatorEvents  KnowledgeProfileOperatorEvent[]
  knowledgeProfileAdoptions       KnowledgeProfileAdoptionReceipt[] @relation("KnowledgeProfileAdoptionActor")
  createdProjectInvitations       ProjectInvitation[]               @relation("ProjectInvitationCreator")
  acceptedProjectInvitations      ProjectInvitation[]               @relation("ProjectInvitationAcceptor")
  createdImportSources            ImportSource[]                    @relation("ImportSourceCreator")

  @@unique([issuer, subject])
  @@index([email])
  @@map("principals")
}

model PrincipalCommunicationPreference {
  principalId         String    @id @map("principal_id")
  productUpdatesEmail Boolean   @default(false) @map("product_updates_email")
  researchInvitations Boolean   @default(false) @map("research_invitations")
  revision            Int       @default(0)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  principal           Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@map("principal_communication_preferences")
}

model Workspace {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  createdById        String              @map("created_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  createdBy          Principal           @relation("WorkspaceCreator", fields: [createdById], references: [id])
  members            WorkspaceMember[]
  projects           Project[]
  knowledgeReleases  KnowledgeRelease[]
  projectLineages    ProjectLineage[]
  projectInvitations ProjectInvitation[]

  @@index([createdById])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  principalId String        @map("principal_id")
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  principal   Principal     @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@id([workspaceId, principalId])
  @@index([principalId])
  @@map("workspace_members")
}

model Project {
  id                    String                    @id @default(cuid())
  workspaceId           String                    @map("workspace_id")
  createdById           String                    @map("created_by_id")
  title                 String
  summary               String?
  status                ProjectStatus             @default(active)
  revision              Int                       @default(0)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  workspace             Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy             Principal                 @relation("ProjectCreator", fields: [createdById], references: [id])
  members               ProjectMember[]
  threads               Thread[]
  artifacts             Artifact[]
  boards                Board[]
  files                 FileAsset[]
  fileUploads           FileUploadSession[]
  releases              ProjectRelease[]
  shares                ShareGrant[]
  lineage               ProjectLineage?
  sourceDuplicates      ProjectDuplicate[]        @relation("ProjectDuplicateSource")
  duplicateReceipt      ProjectDuplicate?         @relation("ProjectDuplicateTarget")
  designSystemImports   DesignSystemImport[]      @relation("DesignSystemImportTargetProject")
  designSystemCreations DesignSystemCreation[]    @relation("DesignSystemCreationProject")
  boardReplaceReceipts  BoardReplaceReceipt[]
  artifactCreations     ArtifactCreationReceipt[] @relation("ArtifactCreationProject")
  knowledgeToolGrants   KnowledgeToolGrant[]      @relation("KnowledgeToolGrantProject")
  invitations           ProjectInvitation[]
  previews              ProjectPreview[]
  submissionIntents     SubmissionIntent[]
  canvasAgentSessions   CanvasAgentSession[]
  importSources         ImportSource[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status, updatedAt])
  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  projectId   String      @map("project_id")
  workspaceId String      @map("workspace_id")
  principalId String      @map("principal_id")
  role        ProjectRole
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  project     Project     @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)
  principal   Principal   @relation(fields: [principalId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([projectId, principalId])
  @@index([principalId, role, projectId])
  @@index([workspaceId, principalId])
  @@map("project_members")
}

model ProjectInvitation {
  id             String                   @id @default(cuid())
  projectId      String                   @map("project_id")
  workspaceId    String                   @map("workspace_id")
  email          String                   @db.VarChar(320)
  role           ProjectRole
  status         ProjectInvitationStatus  @default(pending)
  deliveryStatus InvitationDeliveryStatus @default(not_configured) @map("delivery_status")
  createdById    String                   @map("created_by_id")
  acceptedById   String?                  @map("accepted_by_id")
  idempotencyKey String                   @map("idempotency_key")
  requestHash    String                   @map("request_hash") @db.Char(64)
  tokenHash      String                   @unique @map("token_hash") @db.Char(64)
  tokenKeyId     String                   @map("token_key_id") @db.VarChar(32)
  revision       Int                      @default(0)
  expiresAt      DateTime                 @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?                @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?                @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  project        Project                  @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdBy      Principal                @relation("ProjectInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy     Principal?               @relation("ProjectInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, createdById, idempotencyKey])
  @@index([projectId, status, createdAt, id])
  @@index([workspaceId, email])
  @@index([createdById, createdAt])
  @@index([acceptedById])
  @@map("project_invitations")
}

model Thread {
  id                  String               @id @default(cuid())
  projectId           String               @map("project_id")
  createdById         String               @map("created_by_id")
  title               String
  status              ThreadStatus         @default(active)
  revision            Int                  @default(0)
  entrySequence       Int                  @default(0) @map("entry_sequence")
  idempotencyKey      String?              @map("idempotency_key")
  requestHash         String?              @map("request_hash")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy           Principal            @relation("ThreadCreator", fields: [createdById], references: [id])
  entries             ThreadEntry[]
  runs                Run[]
  submissionIntents   SubmissionIntent[]
  runtimeBinding      RuntimeBinding?
  canvasAgentSessions CanvasAgentSession[]

  @@unique([projectId, idempotencyKey])
  @@unique([id, projectId])
  @@index([projectId, status, updatedAt])
  @@index([createdById])
  @@map("threads")
}

model SubmissionIntent {
  id                   String                       @id @default(cuid())
  projectId            String                       @map("project_id")
  threadId             String                       @map("thread_id")
  createdById          String                       @map("created_by_id")
  status               SubmissionIntentStatus       @default(pending)
  request              Json
  requestHash          String                       @map("request_hash") @db.Char(64)
  idempotencyKey       String                       @map("idempotency_key")
  runIdempotencyKey    String                       @map("run_idempotency_key")
  runId                String?                      @unique @map("run_id")
  lastFailureCode      String?                      @map("last_failure_code") @db.VarChar(120)
  lastFailureDetail    String?                      @map("last_failure_detail") @db.VarChar(2000)
  lastFailureRetryable Boolean?                     @map("last_failure_retryable")
  revision             Int                          @default(0)
  submittedAt          DateTime?                    @map("submitted_at") @db.Timestamptz(6)
  cancelledAt          DateTime?                    @map("cancelled_at") @db.Timestamptz(6)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  project              Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  thread               Thread                       @relation(fields: [threadId, projectId], references: [id, projectId], onDelete: Cascade, onUpdate: Restrict)
  createdBy            Principal                    @relation("SubmissionIntentCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  run                  Run?                         @relation("SubmissionIntentRun", fields: [runId, threadId], references: [id, threadId], onDelete: NoAction, onUpdate: Restrict)
  attachments          SubmissionIntentAttachment[]

  @@unique([id, projectId])
  @@unique([threadId, idempotencyKey])
  @@unique([threadId, runIdempotencyKey])
  @@unique([runId, threadId])
  @@index([projectId, createdById, status, updatedAt])
  @@index([createdById, createdAt])
  @@map("submission_intents")
}

model SubmissionIntentAttachment {
  submissionIntentId String                         @map("submission_intent_id")
  projectId          String                         @map("project_id")
  position           Int
  kind               SubmissionIntentAttachmentKind
  fileAssetId        String?                        @map("file_asset_id")
  clientFingerprint  String?                        @map("client_fingerprint") @db.VarChar(256)
  fileName           String?                        @map("file_name") @db.VarChar(500)
  declaredMediaType  String?                        @map("declared_media_type") @db.VarChar(255)
  byteSize           BigInt?                        @map("byte_size")
  lastModified       BigInt?                        @map("last_modified")
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  submissionIntent   SubmissionIntent               @relation(fields: [submissionIntentId, projectId], references: [id, projectId], onDelete: Cascade, onUpdate: Restrict)
  file               FileAsset?                     @relation(fields: [fileAssetId, projectId], references: [id, projectId], onDelete: NoAction, onUpdate: Restrict)

  @@id([submissionIntentId, position])
  @@unique([submissionIntentId, fileAssetId])
  @@unique([submissionIntentId, clientFingerprint])
  @@index([fileAssetId])
  @@index([projectId])
  @@map("submission_intent_attachments")
}

model ThreadEntry {
  id              String          @id @default(cuid())
  threadId        String          @map("thread_id")
  sequence        Int
  role            ThreadEntryRole
  kind            ThreadEntryKind @default(message)
  content         Json
  producedByRunId String?         @map("produced_by_run_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  thread          Thread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  producedByRun   Run?            @relation("RunProducedEntries", fields: [producedByRunId], references: [id], onDelete: SetNull)
  outputForRun    Run?            @relation("RunOutputEntry")

  @@unique([threadId, sequence])
  @@index([producedByRunId])
  @@map("thread_entries")
}

model Run {
  id                           String                     @id @default(cuid())
  projectId                    String                     @map("project_id")
  threadId                     String                     @map("thread_id")
  retryOfRunId                 String?                    @map("retry_of_run_id")
  createdById                  String                     @map("created_by_id")
  knowledgeReleaseId           String?                    @map("knowledge_release_id")
  designStyleArtifactVersionId String?                    @map("design_style_artifact_version_id")
  designStyleSnapshot          Json?                      @map("design_style_snapshot")
  designStyleSnapshotSha256    String?                    @map("design_style_snapshot_sha256")
  idempotencyKey               String                     @map("idempotency_key")
  requestHash                  String                     @map("request_hash")
  requestId                    String                     @unique @map("request_id")
  request                      Json
  status                       RunStatus                  @default(queued)
  phase                        RunPhase?
  phaseLabel                   String?                    @map("phase_label")
  progress                     Float?
  modelId                      String                     @map("model_id")
  traceId                      String                     @map("trace_id")
  attempt                      Int                        @default(0)
  eventSequence                Int                        @default(0) @map("event_sequence")
  executionOwnerId             String?                    @map("execution_owner_id") @db.VarChar(128)
  executionEpoch               Int                        @default(0) @map("execution_epoch")
  executionHeartbeatAt         DateTime?                  @map("execution_heartbeat_at") @db.Timestamptz(6)
  executionLeaseExpiresAt      DateTime?                  @map("execution_lease_expires_at") @db.Timestamptz(6)
  cancelRequestedAt            DateTime?                  @map("cancel_requested_at")
  startedAt                    DateTime?                  @map("started_at")
  finishedAt                   DateTime?                  @map("finished_at")
  errorCode                    String?                    @map("error_code")
  errorDetail                  String?                    @map("error_detail")
  errorRetryable               Boolean?                   @map("error_retryable")
  cancellationReason           String?                    @map("cancellation_reason")
  outputEntryId                String?                    @unique @map("output_entry_id")
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")
  thread                       Thread                     @relation(fields: [threadId, projectId], references: [id, projectId], onDelete: Cascade, onUpdate: Restrict)
  retryOfRun                   Run?                       @relation("RunRetries", fields: [retryOfRunId, threadId], references: [id, threadId], onDelete: Restrict, onUpdate: Restrict)
  retries                      Run[]                      @relation("RunRetries")
  createdBy                    Principal                  @relation(fields: [createdById], references: [id])
  knowledgeRelease             KnowledgeRelease?          @relation(fields: [knowledgeReleaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  designStyleArtifactVersion   ArtifactVersion?           @relation("RunDesignStyleArtifactVersion", fields: [designStyleArtifactVersionId, projectId], references: [id, projectId], onDelete: NoAction, onUpdate: Restrict)
  events                       RunEvent[]
  draft                        RunDraft?
  approvals                    RunApproval[]
  producedEntries              ThreadEntry[]              @relation("RunProducedEntries")
  outputEntry                  ThreadEntry?               @relation("RunOutputEntry", fields: [outputEntryId], references: [id], onDelete: SetNull)
  artifactVersions             ArtifactVersion[]
  runtimeAttempts              RuntimeAttempt[]
  knowledgeToolGrants          KnowledgeToolGrant[]       @relation("KnowledgeToolGrantRun")
  submissionIntent             SubmissionIntent?          @relation("SubmissionIntentRun")
  canvasAgentSessions          CanvasAgentSession[]
  prototypePatchProjections    PrototypePatchProjection[]
  sourceSnapshots              RunSourceSnapshot[]
  cancellationReceipts         RunCancellationReceipt[]

  @@unique([threadId, idempotencyKey])
  @@unique([id, projectId])
  @@unique([id, threadId])
  @@index([projectId, createdAt])
  @@index([threadId, status])
  @@index([createdById])
  @@index([knowledgeReleaseId])
