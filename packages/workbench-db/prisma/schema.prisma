  status            EmbeddingProfileStatus           @default(candidate)
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @default(now()) @updatedAt @map("updated_at")
  knowledgeReleases KnowledgeRelease[]
  retrievalProfiles RetrievalProfile[]
  embeddingBatches  KnowledgeEmbeddingBatch[]
  chunkEmbeddings   KnowledgeChunkEmbedding[]
  adoptionReceipt   KnowledgeProfileAdoptionReceipt?

  @@unique([id, dimension])
  @@unique([id, specSha256])
  @@unique([id, specSha256, dimension])
  @@index([status, createdAt])
  @@map("embedding_profiles")
}

model RetrievalProfile {
  id                         String                           @id
  spec                       Json
  specSha256                 String                           @unique @map("spec_sha256")
  embeddingProfileId         String                           @map("embedding_profile_id")
  embeddingProfileSpecSha256 String                           @map("embedding_profile_spec_sha256")
  embeddingDimension         Int                              @map("embedding_dimension")
  status                     RetrievalProfileStatus           @default(candidate)
  createdAt                  DateTime                         @default(now()) @map("created_at")
  updatedAt                  DateTime                         @default(now()) @updatedAt @map("updated_at")
  embeddingProfile           EmbeddingProfile                 @relation(fields: [embeddingProfileId, embeddingProfileSpecSha256, embeddingDimension], references: [id, specSha256, dimension], onDelete: Restrict, onUpdate: Restrict, map: "retrieval_profiles_embedding_profile_fkey")
  knowledgeReleases          KnowledgeRelease[]
  adoptionReceipt            KnowledgeProfileAdoptionReceipt?

  @@unique([id, specSha256])
  @@unique([id, specSha256, embeddingProfileId, embeddingProfileSpecSha256, embeddingDimension], map: "retrieval_profiles_identity_key")
  @@index([status, createdAt])
  @@index([embeddingProfileId, embeddingProfileSpecSha256, embeddingDimension, status], map: "retrieval_profiles_embedding_status_idx")
  @@map("retrieval_profiles")
}

model KnowledgeProfileOperatorEvent {
  id              BigInt                         @id @default(autoincrement())
  principalId     String                         @map("principal_id")
  action          KnowledgeProfileOperatorAction
  authorizedBy    String                         @map("authorized_by")
  changeReference String                         @unique @map("change_reference")
  createdAt       DateTime                       @default(now()) @map("created_at")
  principal       Principal                      @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([principalId, id])
  @@map("knowledge_profile_operator_events")
}

model KnowledgeProfileAdoptionReceipt {
  id                         String                @id @default(cuid())
  profileKind                KnowledgeProfileKind  @map("profile_kind")
  profileVersion             Int                   @default(1) @map("profile_version")
  embeddingProfileId         String?               @map("embedding_profile_id")
  embeddingProfileSpecSha256 String?               @map("embedding_profile_spec_sha256")
  retrievalProfileId         String?               @map("retrieval_profile_id")
  retrievalProfileSpecSha256 String?               @map("retrieval_profile_spec_sha256")
  actorPrincipalId           String                @map("actor_principal_id")
  scope                      KnowledgeProfileScope @default(global)
  adoptedAt                  DateTime              @default(now()) @map("adopted_at")
  embeddingProfile           EmbeddingProfile?     @relation(fields: [embeddingProfileId, embeddingProfileSpecSha256], references: [id, specSha256], onDelete: Restrict, onUpdate: Restrict)
  retrievalProfile           RetrievalProfile?     @relation(fields: [retrievalProfileId, retrievalProfileSpecSha256], references: [id, specSha256], onDelete: Restrict, onUpdate: Restrict)
  actor                      Principal             @relation("KnowledgeProfileAdoptionActor", fields: [actorPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([embeddingProfileId, embeddingProfileSpecSha256])
  @@unique([retrievalProfileId, retrievalProfileSpecSha256])
  @@index([profileKind, adoptedAt, id])
  @@index([actorPrincipalId, adoptedAt])
  @@map("knowledge_profile_adoption_receipts")
}

model KnowledgeChunkEmbedding {
  chunkId           String                @map("chunk_id")
  releaseId         String                @map("release_id")
  profileId         String                @map("profile_id")
  profileSpecSha256 String                @map("profile_spec_sha256")
  dimension         Int
  embedding         Unsupported("vector")
  embeddingSha256   String                @map("embedding_sha256")
  createdAt         DateTime              @default(now()) @map("created_at")
  chunk             KnowledgeChunk        @relation(fields: [chunkId, releaseId], references: [id, releaseId], onDelete: Cascade, onUpdate: Restrict)
  profile           EmbeddingProfile      @relation(fields: [profileId, profileSpecSha256, dimension], references: [id, specSha256, dimension], onDelete: Restrict, onUpdate: Restrict)

  @@id([chunkId, profileId])
  @@index([releaseId, profileId])
  @@index([profileId, dimension])
  @@map("knowledge_chunk_embeddings")
}

model KnowledgeEmbeddingBatch {
  id                String                        @id
  releaseId         String                        @map("release_id")
  profileId         String                        @map("profile_id")
  profileSpecSha256 String                        @map("profile_spec_sha256")
  dimension         Int
  sequence          Int
  chunkIds          String[]                      @map("chunk_ids")
  inputCount        Int                           @map("input_count")
  inputSha256       String                        @map("input_sha256")
  status            KnowledgeEmbeddingBatchStatus @default(pending)
  attemptCount      Int                           @default(0) @map("attempt_count")
  leaseToken        String?                       @map("lease_token")
  queueJobId        String?                       @map("queue_job_id")
  queueRetryCount   Int?                          @map("queue_retry_count")
  tokenCount        Int?                          @map("token_count")
  outputSha256      String?                       @map("output_sha256")
  lastErrorCode     String?                       @map("last_error_code")
  lastErrorDetail   String?                       @map("last_error_detail")
  lastErrorAt       DateTime?                     @map("last_error_at")
  startedAt         DateTime?                     @map("started_at")
  finishedAt        DateTime?                     @map("finished_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @default(now()) @updatedAt @map("updated_at")
  release           KnowledgeRelease              @relation(fields: [releaseId, profileId, profileSpecSha256, dimension], references: [id, embeddingProfileId, embeddingProfileSpecSha256, embeddingDimension], onDelete: Cascade, onUpdate: Restrict)
  profile           EmbeddingProfile              @relation(fields: [profileId, profileSpecSha256, dimension], references: [id, specSha256, dimension], onDelete: Restrict, onUpdate: Restrict)

  @@unique([releaseId, sequence])
  @@index([releaseId, status, sequence])
  @@index([profileId, profileSpecSha256, dimension])
  @@map("knowledge_embedding_batches")
}
