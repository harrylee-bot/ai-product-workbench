generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  disabled
}

enum ProjectStatus {
  draft
  clarifying
  designing
  prd_ready
  prototype_ready
  qa_failed
  completed
  archived
  deleted
}

enum ConversationStatus {
  active
  archived
  deleted
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageType {
  text
  clarification
  agent_summary
  error
  prd_update
  prototype_update
  qa_update
}

enum FileStorageProvider {
  local
  s3
  oss
}

enum FileAssetStatus {
  uploaded
  parsing
  parsed
  parse_failed
  unsupported
  deleted
}

enum ParseResultStatus {
  success
  partial_success
  failed
}

enum FileParserType {
  plain_text
  markdown
  docx
  pdf
  image
  zip
  axure_html_zip
  rp_reference
  unsupported
}

enum FileChunkSourceType {
  text
  section
  page
  image_context
  axure_page
  pdf_page
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  email          String?         @unique
  passwordHash   String          @map("password_hash")
  displayName    String          @map("display_name")
  role           UserRole        @default(user)
  status         UserStatus      @default(active)
  lastLoginAt    DateTime?       @map("last_login_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  loginAuditLogs LoginAuditLog[]
  projects       Project[]
  conversations  Conversation[]
  messages       Message[]
  fileAssets     FileAsset[]

  @@map("users")
}

model LoginAuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  account    String
  success    Boolean
  failReason String?  @map("fail_reason")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([account])
  @@index([userId])
  @@map("login_audit_logs")
}

model Project {
  id                          String         @id @default(cuid())
  ownerId                     String         @map("owner_id")
  title                       String
  description                 String?
  status                      ProjectStatus  @default(draft)
  currentConversationId       String?        @map("current_conversation_id")
  currentProductDesignStateId String?        @map("current_product_design_state_id")
  currentPrdDocumentId        String?        @map("current_prd_document_id")
  currentPrototypeArtifactId  String?        @map("current_prototype_artifact_id")
  latestQaReportId            String?        @map("latest_qa_report_id")
  lastActivityAt              DateTime       @default(now()) @map("last_activity_at")
  archivedAt                  DateTime?      @map("archived_at")
  deletedAt                   DateTime?      @map("deleted_at")
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  owner                       User           @relation(fields: [ownerId], references: [id])
  conversations               Conversation[]
  messages                    Message[]
  fileAssets                  FileAsset[]

  @@index([ownerId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([deletedAt])
  @@map("projects")
}

model Conversation {
  id            String             @id @default(cuid())
  projectId     String             @map("project_id")
  ownerId       String             @map("owner_id")
  title         String
  summary       String?
  messageCount  Int                @default(0) @map("message_count")
  lastMessageAt DateTime?          @map("last_message_at")
  status        ConversationStatus @default(active)
  deletedAt     DateTime?          @map("deleted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  project       Project            @relation(fields: [projectId], references: [id])
  owner         User               @relation(fields: [ownerId], references: [id])
  messages      Message[]
  fileAssets    FileAsset[]

  @@index([projectId])
  @@index([ownerId])
  @@index([lastMessageAt])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id                         String       @id @default(cuid())
  projectId                  String       @map("project_id")
  conversationId             String       @map("conversation_id")
  userId                     String?      @map("user_id")
  role                       MessageRole
  type                       MessageType  @default(text)
  content                    String
  attachments                Json?
  metadata                   Json?
  relatedRunId               String?      @map("related_run_id")
  relatedPrdDocumentId       String?      @map("related_prd_document_id")
  relatedPrototypeArtifactId String?      @map("related_prototype_artifact_id")
  relatedQaReportId          String?      @map("related_qa_report_id")
  createdAt                  DateTime     @default(now()) @map("created_at")
  project                    Project      @relation(fields: [projectId], references: [id])
  conversation               Conversation @relation(fields: [conversationId], references: [id])
  user                       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fileAssets                 FileAsset[]

  @@index([projectId])
  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@map("messages")
}

model FileAsset {
  id              String              @id @default(uuid())
  projectId       String              @map("project_id")
  conversationId  String?             @map("conversation_id")
  messageId       String?             @map("message_id")
  uploadedBy      String              @map("uploaded_by")
  originalName    String              @map("original_name")
  storedName      String              @map("stored_name")
  mimeType        String              @map("mime_type")
  extension       String
  size            Int
  storageProvider FileStorageProvider @default(local) @map("storage_provider")
  storagePath     String              @map("storage_path")
  publicUrl       String?             @map("public_url")
  status          FileAssetStatus     @default(uploaded)
  parseResultId   String?             @map("parse_result_id")
  parseError      String?             @map("parse_error")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  project         Project             @relation(fields: [projectId], references: [id])
  conversation    Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message         Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader        User                @relation(fields: [uploadedBy], references: [id])
  parseResult     FileParseResult?
  chunks          FileChunk[]

  @@index([projectId])
  @@index([conversationId])
  @@index([messageId])
  @@index([uploadedBy])
  @@index([status])
  @@index([createdAt])
  @@map("file_assets")
}

model FileParseResult {
  id              String            @id @default(uuid())
  fileAssetId     String            @unique @map("file_asset_id")
  projectId       String            @map("project_id")
  status          ParseResultStatus
  parserType      FileParserType    @map("parser_type")
  title           String?
  summary         String?
  extractedText   String?           @map("extracted_text")
  wordCount       Int?              @map("word_count")
  sections        Json?
  pages           Json?
  images          Json?
  visualContexts  Json?             @map("visual_contexts")
  axureInfo       Json?             @map("axure_info")
  errorMessage    String?           @map("error_message")
  warnings        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  fileAsset       FileAsset         @relation(fields: [fileAssetId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([parserType])
  @@map("file_parse_results")
}

model FileChunk {
  id             String              @id @default(uuid())
  fileAssetId    String              @map("file_asset_id")
  projectId      String              @map("project_id")
  chunkIndex     Int                 @map("chunk_index")
  content        String
  tokenEstimate  Int?                @map("token_estimate")
  sourceType     FileChunkSourceType @map("source_type")
  sourceRef      String?             @map("source_ref")
  createdAt      DateTime            @default(now()) @map("created_at")
  fileAsset      FileAsset           @relation(fields: [fileAssetId], references: [id])

  @@index([fileAssetId])
  @@index([projectId])
  @@index([chunkIndex])
  @@map("file_chunks")
}
