generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  disabled
}

enum ProjectStatus {
  draft
  clarifying
  designing
  prd_ready
  prototype_ready
  qa_failed
  completed
  archived
  deleted
}

enum ConversationStatus {
  active
  archived
  deleted
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageType {
  text
  clarification
  agent_summary
  error
  prd_update
  prototype_update
  qa_update
}

enum FileStorageProvider {
  local
  s3
  oss
}

enum FileAssetStatus {
  uploaded
  parsing
  parsed
  parse_failed
  unsupported
  deleted
}

enum ParseResultStatus {
  success
  partial_success
  failed
}

enum FileParserType {
  plain_text
  markdown
  docx
  pdf
  image
  zip
  axure_html_zip
  rp_reference
  unsupported
}

enum FileChunkSourceType {
  text
  section
  page
  image_context
  axure_page
  pdf_page
}

enum ModelProviderType {
  openai_compatible
}

enum ModelTaskType {
  intent_detection
  knowledge_classification
  requirement_analysis
  product_design
  prd_generation
  prototype_design
  prototype_code_generation
  patch_planning
  qa_check
  knowledge_extraction
  general_chat
}

enum ModelResponseFormat {
  text
  json
}

enum ModelCallStatus {
  running
  succeeded
  failed
}

enum ProductDesignStateStatus {
  draft
  clarifying
  design_ready
  prd_ready
  prototype_ready
  patching
  qa_failed
  confirmed
}

enum ProductDesignChangeType {
  create
  update
  patch
  rollback
  confirm_assumption
  reject_assumption
  answer_question
}

enum RequirementDocumentStatus {
  draft
  generating
  ready
  failed
  confirmed
}

enum PrototypeTargetDevice {
  desktop
  mobile
  both
}

enum PrototypeArtifactStatus {
  generating
  ready
  failed
}

enum PatchRecordStatus {
  planned
  applying
  applied
  failed
  cancelled
  needs_confirmation
}

enum QAReportStatus {
  running
  passed
  failed
  warning
}

enum QAReportTrigger {
  initial_generation
  patch
  manual
  rollback
  pre_confirm
}

enum RollbackType {
  product_design_state
}

enum RollbackRecordStatus {
  running
  completed
  failed
}

enum KnowledgeType {
  strong_rule
  default_rule
  reference_case
  design_pattern
  prd_writing_rule
  prototype_rule
  business_concept
}

enum KnowledgeStatus {
  draft
  active
  disabled
  archived
}

enum KnowledgeScope {
  global
  project
}

enum KnowledgePriority {
  low
  medium
  high
}

enum KnowledgeSource {
  manual
  project_extraction
  file_extraction
  prd_confirmation
  prototype_confirmation
}

enum KnowledgeCandidateSource {
  prd
  prototype
  product_design_state
  conversation
  uploaded_file
}

enum KnowledgeCandidateStatus {
  pending
  approved
  rejected
  merged
}

enum AdminAuditTargetType {
  user
  project
  model_provider
  model_config
  model_task_profile
  knowledge_item
  knowledge_candidate
  system
}

enum AgentRunStatus {
  running
  succeeded
  failed
  cancelled
}

enum AgentStepStatus {
  pending
  running
  succeeded
  failed
  skipped
}

enum AgentName {
  orchestrator
  intent_agent
  knowledge_agent
  requirement_analyst_agent
  product_designer_agent
  prd_writer_agent
  prototype_designer_agent
  prototype_code_agent
  patch_agent
  qa_agent
  knowledge_extractor_agent
}

enum UserIntent {
  new_requirement
  complete_requirement
  clarification_answer
  generate_prd
  generate_prototype
  patch_document
  patch_prototype
  global_adjustment
  export_word
  export_html
  knowledge_update
  general_question
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  email          String?         @unique
  passwordHash   String          @map("password_hash")
  displayName    String          @map("display_name")
  role           UserRole        @default(user)
  status         UserStatus      @default(active)
  lastLoginAt    DateTime?       @map("last_login_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  loginAuditLogs LoginAuditLog[]
  projects       Project[]
  conversations  Conversation[]
  messages       Message[]
  fileAssets     FileAsset[]
  agentRuns      AgentRunLog[]
  adminAuditLogs AdminAuditLog[]

  @@map("users")
}

model LoginAuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  account    String
  success    Boolean
  failReason String?  @map("fail_reason")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([account])
  @@index([userId])
  @@map("login_audit_logs")
}

model Project {
  id                          String         @id @default(cuid())
  ownerId                     String         @map("owner_id")
  title                       String
  description                 String?
  status                      ProjectStatus  @default(draft)
  currentConversationId       String?        @map("current_conversation_id")
  currentProductDesignStateId String?        @map("current_product_design_state_id")
  currentPrdDocumentId        String?        @map("current_prd_document_id")
  currentPrototypeArtifactId  String?        @map("current_prototype_artifact_id")
  latestQaReportId            String?        @map("latest_qa_report_id")
  lastActivityAt              DateTime       @default(now()) @map("last_activity_at")
  archivedAt                  DateTime?      @map("archived_at")
  deletedAt                   DateTime?      @map("deleted_at")
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  owner                       User           @relation(fields: [ownerId], references: [id])
  conversations               Conversation[]
  messages                    Message[]
  fileAssets                  FileAsset[]
  productDesignStates         ProductDesignState[]
  productDesignVersions       ProductDesignVersion[]
  productDesignChangeLogs     ProductDesignChangeLog[]
  requirementDocuments        RequirementDocument[]
  requirementDocumentVersions RequirementDocumentVersion[]
  prototypeSpecs              PrototypeSpecRecord[]
  prototypeArtifacts          PrototypeArtifact[]
  prototypeVersions           PrototypeVersion[]
  patchRecords                PatchRecord[]
  qaReports                   QAReport[]
  rollbackRecords             RollbackRecord[]
  knowledgeCandidates         KnowledgeCandidate[]
  agentRuns                   AgentRunLog[]
  vibeStreamEvents            VibeStreamEventLog[]
  interactionEvents           ProductInteractionEvent[]
  productInsights             ProductInsight[]
  productReviewReports        ProductReviewReport[]
  evolutionPlans              EvolutionPlan[]
  evolutionPatchExecutions    EvolutionPatchExecution[]
  productMemories             ProductMemory[]
  orchestrationRuns           OrchestrationRun[]

  @@index([ownerId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([deletedAt])
  @@map("projects")
}

model Conversation {
  id            String             @id @default(cuid())
  projectId     String             @map("project_id")
  ownerId       String             @map("owner_id")
  title         String
  summary       String?
  messageCount  Int                @default(0) @map("message_count")
  lastMessageAt DateTime?          @map("last_message_at")
  status        ConversationStatus @default(active)
  deletedAt     DateTime?          @map("deleted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  project       Project            @relation(fields: [projectId], references: [id])
  owner         User               @relation(fields: [ownerId], references: [id])
  messages      Message[]
  fileAssets    FileAsset[]
  agentRuns     AgentRunLog[]
  patchRecords  PatchRecord[]

  @@index([projectId])
  @@index([ownerId])
  @@index([lastMessageAt])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id                         String       @id @default(cuid())
  projectId                  String       @map("project_id")
  conversationId             String       @map("conversation_id")
  userId                     String?      @map("user_id")
  role                       MessageRole
  type                       MessageType  @default(text)
  content                    String
  attachments                Json?
  metadata                   Json?
  relatedRunId               String?      @map("related_run_id")
  relatedPrdDocumentId       String?      @map("related_prd_document_id")
  relatedPrototypeArtifactId String?      @map("related_prototype_artifact_id")
  relatedQaReportId          String?      @map("related_qa_report_id")
  createdAt                  DateTime     @default(now()) @map("created_at")
  project                    Project      @relation(fields: [projectId], references: [id])
  conversation               Conversation @relation(fields: [conversationId], references: [id])
  user                       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fileAssets                 FileAsset[]

  @@index([projectId])
  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@map("messages")
}

model FileAsset {
  id              String              @id @default(uuid())
  projectId       String              @map("project_id")
  conversationId  String?             @map("conversation_id")
  messageId       String?             @map("message_id")
  uploadedBy      String              @map("uploaded_by")
  originalName    String              @map("original_name")
  storedName      String              @map("stored_name")
  mimeType        String              @map("mime_type")
  extension       String
  size            Int
  storageProvider FileStorageProvider @default(local) @map("storage_provider")
  storagePath     String              @map("storage_path")
  publicUrl       String?             @map("public_url")
  status          FileAssetStatus     @default(uploaded)
  parseResultId   String?             @map("parse_result_id")
  parseError      String?             @map("parse_error")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  project         Project             @relation(fields: [projectId], references: [id])
  conversation    Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message         Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader        User                @relation(fields: [uploadedBy], references: [id])
  parseResult     FileParseResult?
  chunks          FileChunk[]

  @@index([projectId])
  @@index([conversationId])
  @@index([messageId])
  @@index([uploadedBy])
  @@index([status])
  @@index([createdAt])
  @@map("file_assets")
}

model FileParseResult {
  id              String            @id @default(uuid())
  fileAssetId     String            @unique @map("file_asset_id")
  projectId       String            @map("project_id")
  status          ParseResultStatus
  parserType      FileParserType    @map("parser_type")
  title           String?
  summary         String?
  extractedText   String?           @map("extracted_text")
  wordCount       Int?              @map("word_count")
  sections        Json?
  pages           Json?
  images          Json?
  visualContexts  Json?             @map("visual_contexts")
  axureInfo       Json?             @map("axure_info")
  errorMessage    String?           @map("error_message")
  warnings        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  fileAsset       FileAsset         @relation(fields: [fileAssetId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([parserType])
  @@map("file_parse_results")
}

model FileChunk {
  id             String              @id @default(uuid())
  fileAssetId    String              @map("file_asset_id")
  projectId      String              @map("project_id")
  chunkIndex     Int                 @map("chunk_index")
  content        String
  tokenEstimate  Int?                @map("token_estimate")
  sourceType     FileChunkSourceType @map("source_type")
  sourceRef      String?             @map("source_ref")
  createdAt      DateTime            @default(now()) @map("created_at")
  fileAsset      FileAsset           @relation(fields: [fileAssetId], references: [id])

  @@index([fileAssetId])
  @@index([projectId])
  @@index([chunkIndex])
  @@map("file_chunks")
}

model ModelProvider {
  id              String            @id @default(uuid())
  name            String
  type            ModelProviderType @default(openai_compatible)
  baseUrl         String            @map("base_url")
  apiKeyEncrypted String            @map("api_key_encrypted")
  defaultHeaders  Json?             @map("default_headers")
  timeoutMs       Int               @default(60000) @map("timeout_ms")
  isDefault       Boolean           @default(false) @map("is_default")
  isEnabled       Boolean           @default(true) @map("is_enabled")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  models          ModelConfig[]
  callLogs        ModelCallLog[]

  @@index([isDefault])
  @@index([isEnabled])
  @@map("model_providers")
}

model ModelConfig {
  id                 String             @id @default(uuid())
  providerId         String             @map("provider_id")
  displayName        String             @map("display_name")
  modelName          String             @map("model_name")
  contextWindow      Int?               @map("context_window")
  maxOutputTokens    Int?               @map("max_output_tokens")
  supportsStreaming  Boolean            @default(true) @map("supports_streaming")
  supportsJsonMode   Boolean            @default(false) @map("supports_json_mode")
  supportsMultimodal Boolean            @default(false) @map("supports_multimodal")
  defaultTemperature Float              @default(0.2) @map("default_temperature")
  defaultMaxTokens   Int?               @map("default_max_tokens")
  isEnabled          Boolean            @default(true) @map("is_enabled")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  provider           ModelProvider      @relation(fields: [providerId], references: [id])
  taskProfiles       ModelTaskProfile[]
  callLogs           ModelCallLog[]

  @@index([providerId])
  @@index([isEnabled])
  @@map("model_configs")
}

model ModelTaskProfile {
  id             String              @id @default(uuid())
  taskType       ModelTaskType       @unique @map("task_type")
  modelConfigId  String              @map("model_config_id")
  temperature    Float?
  maxTokens      Int?                @map("max_tokens")
  responseFormat ModelResponseFormat @default(text) @map("response_format")
  retryCount     Int                 @default(1) @map("retry_count")
  timeoutMs      Int?                @map("timeout_ms")
  isEnabled      Boolean             @default(true) @map("is_enabled")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  modelConfig    ModelConfig         @relation(fields: [modelConfigId], references: [id])

  @@index([taskType])
  @@index([isEnabled])
  @@map("model_task_profiles")
}

model ModelCallLog {
  id               String          @id @default(uuid())
  traceId          String?         @map("trace_id")
  runId            String?         @map("run_id")
  agentName        String?         @map("agent_name")
  taskType         ModelTaskType   @map("task_type")
  providerId       String          @map("provider_id")
  modelConfigId    String          @map("model_config_id")
  modelName        String          @map("model_name")
  status           ModelCallStatus
  inputSummary     String?         @map("input_summary")
  outputSummary    String?         @map("output_summary")
  promptTokens     Int?            @map("prompt_tokens")
  completionTokens Int?            @map("completion_tokens")
  totalTokens      Int?            @map("total_tokens")
  durationMs       Int?            @map("duration_ms")
  errorCode        String?         @map("error_code")
  errorMessage     String?         @map("error_message")
  createdAt        DateTime        @default(now()) @map("created_at")
  completedAt      DateTime?       @map("completed_at")
  provider         ModelProvider   @relation(fields: [providerId], references: [id])
  modelConfig      ModelConfig     @relation(fields: [modelConfigId], references: [id])
  agentStepLogs    AgentStepLog[]

  @@index([traceId])
  @@index([runId])
  @@index([agentName])
  @@index([taskType])
  @@index([status])
  @@index([createdAt])
  @@map("model_call_logs")
}

model ProductDesignState {
  id                  String                   @id @default(uuid())
  projectId           String                   @map("project_id")
  version             Int
  title               String
  summary             String?
  businessGoal        String                   @map("business_goal")
  background          String?
  targetUsers         Json                     @map("target_users")
  userScenarios       Json                     @map("user_scenarios")
  pages               Json
  features            Json
  backendConfigs      Json                     @map("backend_configs")
  frontendRules       Json                     @map("frontend_rules")
  businessRules       Json                     @map("business_rules")
  stateRules          Json                     @map("state_rules")
  exceptionScenarios  Json                     @map("exception_scenarios")
  acceptanceCriteria  Json                     @map("acceptance_criteria")
  prototypeOutline    Json?                    @map("prototype_outline")
  assumptions         Json
  knowledgeRefs       Json                     @map("knowledge_refs")
  pendingQuestions    Json                     @map("pending_questions")
  confirmedFacts      Json                     @map("confirmed_facts")
  prototypeSpec       Json?                    @map("prototype_spec")
  prdDocument         Json?                    @map("prd_document")
  status              ProductDesignStateStatus @default(draft)
  createdBy           String                   @map("created_by")
  updatedBy           String?                  @map("updated_by")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  project             Project                  @relation(fields: [projectId], references: [id])
  versions            ProductDesignVersion[]
  changeLogs          ProductDesignChangeLog[]
  requirementDocuments RequirementDocument[]
  prototypeSpecs      PrototypeSpecRecord[]
  prototypeArtifacts  PrototypeArtifact[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@map("product_design_states")
}

model ProductDesignVersion {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  stateId   String   @map("state_id")
  version   Int
  snapshot  Json
  reason    String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id])
  state     ProductDesignState @relation(fields: [stateId], references: [id])

  @@index([projectId])
  @@index([stateId])
  @@index([version])
  @@map("product_design_versions")
}

model ProductDesignChangeLog {
  id         String                  @id @default(uuid())
  projectId  String                  @map("project_id")
  stateId    String                  @map("state_id")
  runId      String?                 @map("run_id")
  messageId  String?                 @map("message_id")
  changeType ProductDesignChangeType @map("change_type")
  path       String?
  before     Json?
  after      Json?
  reason     String?
  createdBy  String                  @map("created_by")
  createdAt  DateTime                @default(now()) @map("created_at")
  project    Project                 @relation(fields: [projectId], references: [id])
  state      ProductDesignState      @relation(fields: [stateId], references: [id])

  @@index([projectId])
  @@index([stateId])
  @@index([runId])
  @@index([createdAt])
  @@map("product_design_change_logs")
}

model RequirementDocument {
  id                        String                    @id @default(uuid())
  projectId                 String                    @map("project_id")
  productDesignStateId      String                    @map("product_design_state_id")
  productDesignStateVersion Int                       @map("product_design_state_version")
  title                     String
  status                    RequirementDocumentStatus @default(draft)
  sections                  Json
  assumptions               Json?
  knowledgeRefs             Json?                     @map("knowledge_refs")
  pendingQuestions          Json?                     @map("pending_questions")
  validationNotes           Json?                     @map("validation_notes")
  generatedByRunId          String?                   @map("generated_by_run_id")
  createdBy                 String                    @map("created_by")
  updatedBy                 String?                   @map("updated_by")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  project                   Project                   @relation(fields: [projectId], references: [id])
  productDesignState        ProductDesignState        @relation(fields: [productDesignStateId], references: [id])
  versions                  RequirementDocumentVersion[]

  @@index([projectId])
  @@index([productDesignStateId])
  @@index([status])
  @@index([updatedAt])
  @@map("requirement_documents")
}

model RequirementDocumentVersion {
  id        String              @id @default(uuid())
  documentId String             @map("document_id")
  projectId String              @map("project_id")
  version   Int
  snapshot  Json
  reason    String?
  createdBy String              @map("created_by")
  createdAt DateTime            @default(now()) @map("created_at")
  document  RequirementDocument @relation(fields: [documentId], references: [id])
  project   Project             @relation(fields: [projectId], references: [id])

  @@index([documentId])
  @@index([projectId])
  @@index([version])
  @@map("requirement_document_versions")
}

model PrototypeSpecRecord {
  id                        String                @id @default(uuid())
  projectId                 String                @map("project_id")
  productDesignStateId      String                @map("product_design_state_id")
  productDesignStateVersion Int                   @map("product_design_state_version")
  title                     String
  targetDevice              PrototypeTargetDevice @default(both) @map("target_device")
  styleGuide                Json                  @map("style_guide")
  pages                     Json
  navigation                Json
  interactions              Json
  assumptions               Json?
  knowledgeRefs             Json?                 @map("knowledge_refs")
  generatedByRunId          String?               @map("generated_by_run_id")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")
  project                   Project               @relation(fields: [projectId], references: [id])
  productDesignState        ProductDesignState    @relation(fields: [productDesignStateId], references: [id])
  artifacts                 PrototypeArtifact[]

  @@index([projectId])
  @@index([productDesignStateId])
  @@index([updatedAt])
  @@map("prototype_spec_records")
}

model PrototypeArtifact {
  id                        String                  @id @default(uuid())
  projectId                 String                  @map("project_id")
  prototypeSpecId           String                  @map("prototype_spec_id")
  productDesignStateId      String                  @map("product_design_state_id")
  productDesignStateVersion Int                     @map("product_design_state_version")
  title                     String
  status                    PrototypeArtifactStatus @default(generating)
  htmlContent               String?                 @map("html_content")
  entryFilePath             String?                 @map("entry_file_path")
  previewUrl                String?                 @map("preview_url")
  targetDevice              PrototypeTargetDevice   @default(both) @map("target_device")
  pageCount                 Int                     @default(1) @map("page_count")
  generatedByRunId          String?                 @map("generated_by_run_id")
  errorMessage              String?                 @map("error_message")
  createdBy                 String                  @map("created_by")
  updatedBy                 String?                 @map("updated_by")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  project                   Project                 @relation(fields: [projectId], references: [id])
  productDesignState        ProductDesignState      @relation(fields: [productDesignStateId], references: [id])
  prototypeSpec             PrototypeSpecRecord     @relation(fields: [prototypeSpecId], references: [id])
  versions                  PrototypeVersion[]

  @@index([projectId])
  @@index([prototypeSpecId])
  @@index([productDesignStateId])
  @@index([status])
  @@index([updatedAt])
  @@map("prototype_artifacts")
}

model PrototypeVersion {
  id                    String            @id @default(uuid())
  projectId             String            @map("project_id")
  artifactId            String            @map("artifact_id")
  version               Int
  prototypeSpecSnapshot Json              @map("prototype_spec_snapshot")
  artifactSnapshot      Json              @map("artifact_snapshot")
  reason                String?
  createdBy             String            @map("created_by")
  createdAt             DateTime          @default(now()) @map("created_at")
  project               Project           @relation(fields: [projectId], references: [id])
  artifact              PrototypeArtifact @relation(fields: [artifactId], references: [id])

  @@index([projectId])
  @@index([artifactId])
  @@index([version])
  @@map("prototype_versions")
}

model PatchRecord {
  id                              String            @id @default(uuid())
  projectId                       String            @map("project_id")
  conversationId                  String            @map("conversation_id")
  instructionMessageId            String?           @map("instruction_message_id")
  selectedRegion                  Json              @map("selected_region")
  userInstruction                 String            @map("user_instruction")
  patchPlan                       Json              @map("patch_plan")
  operations                      Json
  status                          PatchRecordStatus @default(planned)
  beforeProductDesignStateVersion Int               @map("before_product_design_state_version")
  afterProductDesignStateVersion  Int?              @map("after_product_design_state_version")
  affectedPrdDocumentId           String?           @map("affected_prd_document_id")
  affectedPrototypeArtifactId     String?           @map("affected_prototype_artifact_id")
  relatedQaReportId               String?           @map("related_qa_report_id")
  generatedByRunId                String?           @map("generated_by_run_id")
  errorMessage                    String?           @map("error_message")
  createdBy                       String            @map("created_by")
  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")
  project                         Project           @relation(fields: [projectId], references: [id])
  conversation                    Conversation      @relation(fields: [conversationId], references: [id])

  @@index([projectId])
  @@index([conversationId])
  @@index([status])
  @@index([generatedByRunId])
  @@index([createdAt])
  @@map("patch_records")
}

model QAReport {
  id                        String          @id @default(uuid())
  projectId                 String          @map("project_id")
  productDesignStateId      String          @map("product_design_state_id")
  productDesignStateVersion Int             @map("product_design_state_version")
  prdDocumentId             String?         @map("prd_document_id")
  prototypeArtifactId       String?         @map("prototype_artifact_id")
  prototypeSpecId           String?         @map("prototype_spec_id")
  status                    QAReportStatus
  trigger                   QAReportTrigger
  checkTypes                Json            @map("check_types")
  summary                   String
  issues                    Json
  blockingCount             Int             @default(0) @map("blocking_count")
  majorCount                Int             @default(0) @map("major_count")
  minorCount                Int             @default(0) @map("minor_count")
  infoCount                 Int             @default(0) @map("info_count")
  generatedByRunId          String?         @map("generated_by_run_id")
  relatedPatchId            String?         @map("related_patch_id")
  relatedRollbackId         String?         @map("related_rollback_id")
  createdBy                 String          @map("created_by")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")
  project                   Project         @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([productDesignStateId])
  @@index([productDesignStateVersion])
  @@index([status])
  @@index([trigger])
  @@index([generatedByRunId])
  @@index([relatedPatchId])
  @@index([relatedRollbackId])
  @@index([createdAt])
  @@map("qa_reports")
}

model RollbackRecord {
