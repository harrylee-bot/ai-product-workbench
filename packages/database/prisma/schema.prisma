model AgentRunLog {
  id             String          @id @default(uuid())
  projectId      String          @map("project_id")
  conversationId String          @map("conversation_id")
  userId         String          @map("user_id")
  intent         UserIntent?
  status         AgentRunStatus  @default(running)
  inputSummary   String          @map("input_summary")
  outputSummary  String?         @map("output_summary")
  result         Json?
  errorMessage   String?         @map("error_message")
  traceId        String          @map("trace_id")
  startedAt      DateTime        @default(now()) @map("started_at")
  endedAt        DateTime?       @map("ended_at")
  durationMs     Int?            @map("duration_ms")
  project        Project         @relation(fields: [projectId], references: [id])
  conversation   Conversation    @relation(fields: [conversationId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  steps          AgentStepLog[]
  streamEvents   VibeStreamEventLog[]

  @@index([projectId])
  @@index([conversationId])
  @@index([userId])
  @@index([intent])
  @@index([status])
  @@index([traceId])
  @@index([startedAt])
  @@map("agent_run_logs")
}

model AgentStepLog {
  id              String          @id @default(uuid())
  runId           String          @map("run_id")
  agentName       AgentName       @map("agent_name")
  status          AgentStepStatus @default(pending)
  inputSummary    String          @map("input_summary")
  outputSummary   String?         @map("output_summary")
  modelCallLogId  String?         @map("model_call_log_id")
  modelProviderId String?         @map("model_provider_id")
  modelName       String?         @map("model_name")
  tokenUsage      Json?           @map("token_usage")
  startedAt       DateTime?       @map("started_at")
  endedAt         DateTime?       @map("ended_at")
  durationMs      Int?            @map("duration_ms")
  errorMessage    String?         @map("error_message")
  run             AgentRunLog     @relation(fields: [runId], references: [id])
  modelCallLog    ModelCallLog?   @relation(fields: [modelCallLogId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([agentName])
  @@index([status])
  @@index([modelCallLogId])
  @@map("agent_step_logs")
}

model VibeStreamEventLog {
  id        String      @id @default(uuid())
  runId     String      @map("run_id")
  projectId String      @map("project_id")
  eventType String      @map("event_type")
  payload   Json
  createdAt DateTime    @default(now()) @map("created_at")
  run       AgentRunLog @relation(fields: [runId], references: [id])
  project   Project     @relation(fields: [projectId], references: [id])

  @@index([runId])
  @@index([projectId])
  @@index([eventType])
  @@index([createdAt])
  @@map("vibe_stream_event_logs")
}
